---
import "@/styles/global.css";
import WhatsAppFloat from "@/components/WhatsAppFloat.astro";
import CookieBanner from "@/components/CookieBanner.astro";


interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  // Aceptado por varias páginas utilitarias (booking-success,
  // booking-edit, booking-cancel) — Layout deriva su propio
  // currentLang de la URL y no lo usa, pero el tipo debe reflejar el
  // uso real para no generar falsos errores de tipo (B09 Gate 11).
  lang?: string;
}

const { title, description, canonical: canonicalProp, noindex = false } = Astro.props;
const currentUrl = Astro.url.pathname;
const currentLang = currentUrl.split("/")[1] || "es";
// Canonical automático — usa el prop si existe, sino construye desde la URL actual
const canonical = canonicalProp || `https://belgotours.com${currentUrl}`;

/**
 * SOLO páginas de detalle de tour:
 * /es/tours/slug
 */
const isTourDetailPage = /^\/[a-z]{2}\/tours\/[^/]+\/?$/.test(currentUrl);

// Hreflang seguro — solo URLs con contenido real en ese idioma.
// IMPORTANTE: no confundir idioma de contenido/interfaz con idioma del tour.
// "pt" solo se incluye donde existe contenido portugués real verificado
// (home, /privacy) — nunca como alias silencioso de una página en español.
const hrefPath = currentUrl.replace(/^\/[a-z]{2}/, '').replace(/\/$/, '');
const isHomePage = hrefPath === '' || hrefPath === '/';
const isTourPath = hrefPath.startsWith('/tours/');
const isLegal = ['/privacy','/terms','/cookies','/legal-notice'].some(p => hrefPath.startsWith(p));

// Home: contenido real verificado en las 5 (incluye pt: título, hero,
// tours destacados, reviews, guías y footer tienen copy portugués real).
const HOME_LANGS = ["es", "en", "it", "fr", "pt"];

// Legal pages: solo /privacy tiene contenido pt real. terms/cookies/
// legal-notice no tienen bloque `pt:` — no se ofrece esa alternativa.
const LEGAL_LANGS: Record<string, string[]> = {
  '/privacy': ["es", "en", "it", "fr", "pt"],
  '/terms': ["es", "en", "it", "fr"],
  '/cookies': ["es", "en", "it", "fr"],
  '/legal-notice': ["es", "en", "it", "fr"],
};

const TOUR_MAP: Record<string, Record<string, string>> = {
  // Free Tour Bruselas: equivalentes reales ES/EN/IT. FR no se incluye porque no existe Free Tour francés.
  // PT no se incluye: no existe contenido de tour en portugués (ver B06A).
  '/tours/free-tour-bruselas':              {es:'/tours/free-tour-bruselas',en:'/tours/free-tour-brussels',it:'/tours/free-tour-bruxelles'},
  '/tours/free-tour-brussels':              {es:'/tours/free-tour-bruselas',en:'/tours/free-tour-brussels',it:'/tours/free-tour-bruxelles'},
  '/tours/free-tour-bruxelles':             {es:'/tours/free-tour-bruselas',en:'/tours/free-tour-brussels',it:'/tours/free-tour-bruxelles'},

  // Free Tour Brujas: por ahora solo ES.
  '/tours/free-tour-brujas':                {es:'/tours/free-tour-brujas'},

  // Free Tour Cerveza: por ahora solo ES.
  '/tours/free-tour-cerveza-bruselas':      {es:'/tours/free-tour-cerveza-bruselas'},

  // Tour Chocolate y Cerveza: tour especial solo ES.
  '/tours/tour-chocolate-cerveza-bruselas': {es:'/tours/tour-chocolate-cerveza-bruselas'},

  // Tours privados Bruselas: equivalentes reales ES/EN/IT/FR.
  '/tours/tour-privado-bruselas':           {es:'/tours/tour-privado-bruselas',en:'/tours/private-tour-brussels',it:'/tours/tour-privato-bruxelles',fr:'/tours/tour-prive-bruxelles'},
  '/tours/private-tour-brussels':           {es:'/tours/tour-privado-bruselas',en:'/tours/private-tour-brussels',it:'/tours/tour-privato-bruxelles',fr:'/tours/tour-prive-bruxelles'},
  '/tours/tour-privato-bruxelles':          {es:'/tours/tour-privado-bruselas',en:'/tours/private-tour-brussels',it:'/tours/tour-privato-bruxelles',fr:'/tours/tour-prive-bruxelles'},
  '/tours/tour-prive-bruxelles':            {es:'/tours/tour-privado-bruselas',en:'/tours/private-tour-brussels',it:'/tours/tour-privato-bruxelles',fr:'/tours/tour-prive-bruxelles'},

  // Tour privado Brujas: por ahora solo ES.
  '/tours/tour-privado-brujas':             {es:'/tours/tour-privado-brujas'},
};
const slugMap = isTourPath ? (TOUR_MAP[hrefPath] ?? null) : null;

let hreflangLinks: {lang: string; href: string}[] = [];
if (isHomePage) {
  hreflangLinks = HOME_LANGS.map(lang => ({lang, href: `https://belgotours.com/${lang}/`}));
} else if (isTourPath && slugMap) {
  hreflangLinks = Object.entries(slugMap).map(([lang, path]) => ({lang, href: `https://belgotours.com/${lang}${path}`}));
} else if (isLegal) {
  const legalKey = Object.keys(LEGAL_LANGS).find(p => hrefPath.startsWith(p));
  const legalLangs = legalKey ? LEGAL_LANGS[legalKey] : [];
  hreflangLinks = legalLangs.map(lang => ({lang, href: `https://belgotours.com/${lang}${hrefPath}`}));
}
---


<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <!-- Consent Mode default + GA4 (Direct gtag, carga condicionada a
         consentimiento analytics real) — debe ejecutarse antes que
         cualquier otro script. Ver ANALYTICS_PLAN.md. -->
    <script is:inline src="/js/analytics.js"></script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- FAVICONS -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {hreflangLinks.map(({lang, href}) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://belgotours.com/en/" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://belgotours.com${currentUrl}`} />
    <!-- B09 Gate 12: /og-image.jpg no existe — 404 confirmado en
         producción, cada share social del sitio entero mostraba
         imagen rota. Sustituido por una foto real ya en vivo en Home
         (Grand Place + paraguas amarillo BelgoTours real), sin
         inventar ni generar nada nuevo. -->
    <meta property="og:image" content="https://belgotours.com/images/ToursDestacados/free-tour-espanol-bruselas-belgotours.webp" />
    <meta property="og:image:width" content="680" />
    <meta property="og:image:height" content="450" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://belgotours.com/images/ToursDestacados/free-tour-espanol-bruselas-belgotours.webp" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Tipografía global (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --font-sans: Inter, system-ui, sans-serif;
        --bg-page: #f9fafb;
        --color-text: #0f172a;
        --color-muted: #6b7280;
        --color-primary: #0f172a;
        --color-secondary: #facc15;
        --color-card: #ffffff;
        --shadow-soft: 0 18px 45px rgba(15, 23, 42, 0.18);
      }
      body {
        margin: 0;
        font-family: var(--font-sans);
        background: var(--bg-page);
        color: var(--color-text);
      }
      
    </style>
  </head>

  <body>
  <!-- HEADER -->
  <slot name="header" />

  <!-- MAIN CONTENT -->
  <main>
    <slot />
  </main>

  <!-- COOKIE BANNER (GLOBAL) -->
  <CookieBanner lang={currentLang} />

  <!-- WHATSAPP FLOTANTE
       ❌ NO en /tours/*
       ✅ Sí en home, blog, info -->
  {!isTourDetailPage && (
    <WhatsAppFloat lang={currentLang} />
  )}
</body>

</html>
