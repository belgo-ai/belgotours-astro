---
import Icon from "@/components/icons/Icon.astro";
import {
  APPROVED_GUIDE_PHOTO_FALLBACK,
  APPROVED_GUIDE_PHOTO_ALT,
} from "@/lib/guidePhotoFallback";

interface Props {
  lang: string;
}

const { lang } = Astro.props;

// Strapi
const STRAPI_API = import.meta.env.PUBLIC_STRAPI_URL;

// Textos por idioma
const texts = {
  es: {
    title: "Nuestros guías locales",
    subtitle: "Personas reales, guías certificados y apasionados por Bruselas.",
    role: "Guía local de BelgoTours",
  },
  en: {
    title: "Our local guides",
    subtitle: "Real people, certified guides passionate about Brussels.",
    role: "Local guide at BelgoTours",
  },
  it: {
    title: "Le nostre guide locali",
    subtitle: "Persone vere, guide certificate appassionate di Bruxelles.",
    role: "Guida locale di BelgoTours",
  },
  fr: {
    title: "Nos guides locaux",
    subtitle: "De vraies personnes, guides certifiés passionnés par Bruxelles.",
    role: "Guide local BelgoTours",
  },
  pt: {
    title: "Nossos guias locais",
    subtitle: "Pessoas reais, guias certificados apaixonados por Bruxelas.",
    role: "Guia local da BelgoTours",
  }
};

const t = texts[lang] || texts.es;

// Fetch guías activas
let guias = [];

try {
  const res = await fetch(
    `${STRAPI_API}/guias?filters[activo][$eq]=true&populate=foto`
  );

  if (res.ok) {
    const json = await res.json();
    guias = json?.data ?? [];
  }
} catch (e) {
  console.error("Error loading guides", e);
}
---

<section id="guides" class="bg-black py-20">
  <div class="max-w-7xl mx-auto px-4">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-3xl md:text-4xl font-semibold text-white mb-4">
        {t.title}
      </h2>
      <p class="text-[#6B7280] text-lg">
        {t.subtitle}
      </p>
    </div>

    <!-- Grid guías -->
    {guias.length > 0 ? (
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {guias.map((g) => {
          // Gate 22 — corrección incidental: Strapi 5 devuelve el
          // recurso "aplanado" (documentId/nombre/foto directamente en
          // g, sin envoltorio g.attributes de Strapi v4). Con
          // `g.attributes || {}` el nombre y la foto de Strapi
          // quedaban silenciosamente vacíos en producción — descubierto
          // al verificar que la foto real del guía (más abajo) se
          // mostrara junto a su nombre real, no en blanco.
          const a = g.attributes || g;
          // B09 Gate 12 — antes usaba directamente la foto ORIGINAL sin
          // redimensionar (formats?.small/thumbnail ya existen en
          // Strapi y GuidesSectionTour.astro ya los usa correctamente
          // para este mismo dato) — un avatar de 128px no necesita el
          // archivo maestro completo.
          const fotoAttrs = a.foto?.data?.attributes;
          const foto =
            fotoAttrs?.formats?.small?.url ||
            fotoAttrs?.formats?.thumbnail?.url ||
            fotoAttrs?.formats?.medium?.url ||
            fotoAttrs?.url ||
            APPROVED_GUIDE_PHOTO_FALLBACK[g.documentId];
          // Gate 22D — PUBLIC_GUIDE_NAME=HIDDEN: alt nunca incluye el
          // nombre personal del guía, venga la foto de Strapi o del
          // fallback local — sólo el rol genérico (o la descripción
          // específica ya existente para la foto de fallback).
          const fotoAlt =
            (!fotoAttrs?.url && APPROVED_GUIDE_PHOTO_ALT[g.documentId]?.[lang]) ||
            t.role;

          return (
            <article class="flex flex-col items-center text-center">
              {foto ? (
                <img
                  src={foto}
                  alt={fotoAlt}
                  width="128"
                  height="128"
                  loading="lazy"
                  decoding="async"
                  class="w-32 h-32 rounded-full object-cover mb-4 border-2 border-[#FACC15]"
                />
              ) : (
                <div class="w-32 h-32 rounded-full mb-4 border-2 border-[#FACC15] bg-neutral-800 flex items-center justify-center text-neutral-500">
                  <Icon name="user" size={40} />
                </div>
              )}

              {/* Gate 22D — PUBLIC_GUIDE_NAME=HIDDEN: el nombre
                  personal del guía no se renderiza; sólo el rol
                  genérico, ya traducido por idioma. */}
              <p class="text-white font-semibold text-lg">
                {t.role}
              </p>

              {Array.isArray(a.idiomas) && (
                <div class="flex flex-wrap justify-center gap-2 mt-3 text-xs text-[#6B7280]">
                  {a.idiomas.map((i) => (
                    <span class="border border-[#1F2937] px-2 py-1 rounded">
                      {i.toUpperCase()}
                    </span>
                  ))}
                </div>
              )}
            </article>
          );
        })}
      </div>
    ) : (
      <p class="text-center text-[#6B7280]">
        No hay guías disponibles en este momento.
      </p>
    )}

  </div>
</section>
