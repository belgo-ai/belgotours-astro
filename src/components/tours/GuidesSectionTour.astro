---
/**
 * src/components/tours/GuidesSectionTour.astro
 *
 * Bloque 7 (TOURS): muestra SOLO guías asociados a este tour (no global).
 * - NO canibaliza SEO: es un bloque contextual, no una página de guías.
 * - NO hace fetch: recibe `guias` ya populadas desde la página del tour.
 * - Robusto: soporta Strapi v4/v5 (data/attributes) y media con formatos.
 */

import Icon from "@/components/icons/Icon.astro";
import {
  APPROVED_GUIDE_PHOTO_FALLBACK,
  APPROVED_GUIDE_PHOTO_ALT,
} from "@/lib/guidePhotoFallback";

interface Props {
  lang: string;
  guias?: any[]; // Strapi relation array: [{ id, attributes? }] or [{ id, ... }]
  titleOverride?: string;
  subtitleOverride?: string;
}

const { lang, guias = [], titleOverride, subtitleOverride } = Astro.props;

// Base Strapi (para construir URLs absolutas de media)
const STRAPI_BASE =
  (import.meta.env.PUBLIC_STRAPI_URL?.replace("/api", "") ||
    "http://168.119.183.247:1337");

// --- i18n texts (bloque contextual de tour)
const texts = {
  es: {
    title: "Tus guías en este tour",
    subtitle: "Guías locales, cercanos y con experiencia. Te contamos historia + tips reales.",
    role: "Guía local BelgoTours",
    // Gate 22E — estado sin relación de guía activa: confianza a
    // nivel de equipo, sin prometer una persona concreta.
    teamTitle: "Nuestros guías locales",
    teamSubtitle: "El tour es realizado por guías locales de BelgoTours.",
  },
  en: {
    title: "Your guides for this tour",
    subtitle: "Local, friendly and experienced guides. History + real local tips.",
    role: "BelgoTours local guide",
    teamTitle: "Our local guides",
    teamSubtitle: "This tour is run by BelgoTours local guides.",
  },
  it: {
    title: "Le guide di questo tour",
    subtitle: "Guide locali, simpatiche ed esperte. Storia + consigli reali.",
    role: "Guida locale BelgoTours",
    teamTitle: "Le nostre guide locali",
    teamSubtitle: "Il tour è condotto da guide locali di BelgoTours.",
  },
  fr: {
    title: "Vos guides pour ce tour",
    subtitle: "Guides locaux, sympathiques et expérimentés. Histoire + conseils locaux.",
    role: "Guide local BelgoTours",
    teamTitle: "Nos guides locaux",
    teamSubtitle: "Cette visite est assurée par des guides locaux de BelgoTours.",
  },
};

const t = texts[lang as keyof typeof texts] || texts.es;

const title = (titleOverride && String(titleOverride).trim()) || t.title;
const subtitle = (subtitleOverride && String(subtitleOverride).trim()) || t.subtitle;

// Helpers
function pickAttrs(entry: any) {
  return entry?.attributes ?? entry ?? {};
}

function absoluteMediaUrl(url?: string) {
  if (!url) return "";
  // si ya viene absoluta
  if (url.startsWith("http://") || url.startsWith("https://")) return url;
  return `${STRAPI_BASE}${url}`;
}

function guidePhotoUrl(foto: any) {
  // foto puede venir como { data: { attributes: { url, formats }}} o directo
  const f = foto?.data?.attributes ?? foto?.attributes ?? foto ?? null;
  if (!f) return "";

  const url =
    f.formats?.small?.url ||
    f.formats?.thumbnail?.url ||
    f.formats?.medium?.url ||
    f.url;

  return absoluteMediaUrl(url);
}

// Normalizar guías (solo activas si viene "activo")
const normalizedGuides = (Array.isArray(guias) ? guias : [])
  .map((g) => {
    const a = pickAttrs(g);
    // Gate 22E — documentId real de Strapi (mismo identificador que ya
    // usa GuidesSection.astro en Home) para poder aplicar el fallback
    // de foto aprobado únicamente al guía exacto al que pertenece.
    const documentId = g?.documentId ?? a?.documentId ?? "";
    const strapiFotoUrl = guidePhotoUrl(a?.foto);
    return {
      id: g?.id ?? a?.id ?? crypto.randomUUID(),
      documentId,
      nombre: a?.nombre || "",
      slug: a?.slug || "",
      activo: typeof a?.activo === "boolean" ? a.activo : true,
      idiomas: Array.isArray(a?.idiomas) ? a.idiomas : [],
      // Gate 22E — prioridad de foto: 1) foto real de Strapi para ESTE
      // guía, 2) fallback local aprobado SOLO si documentId coincide
      // exactamente con el guía al que pertenece (nunca se atribuye a
      // otra persona), 3) vacío → placeholder neutro de icono.
      fotoUrl: strapiFotoUrl || APPROVED_GUIDE_PHOTO_FALLBACK[documentId] || "",
      fotoIsApprovedFallback: !strapiFotoUrl && Boolean(APPROVED_GUIDE_PHOTO_FALLBACK[documentId]),
    };
  })
  .filter((g) => g.activo && g.nombre);

// UI flags
const hasGuides = normalizedGuides.length > 0;

// Mostrar máx. 4 para no “pesar” la página; el tour es producto, no directorio.
const guidesToShow = normalizedGuides.slice(0, 4);

// Labels idiomas (ES/EN/IT)
function normalizeLangTag(code: string) {
  const c = String(code || "").toLowerCase();
  if (!c) return "";
  return c.toUpperCase();
}

// Gate 22D/22E — PUBLIC_GUIDE_NAME=HIDDEN: el alt de la foto de un
// guía nunca incluye su nombre personal — rol genérico, salvo la
// descripción específica ya aprobada para la foto de fallback local.
function guideImgAlt(g: (typeof normalizedGuides)[number]) {
  return (g.fotoIsApprovedFallback && APPROVED_GUIDE_PHOTO_ALT[g.documentId]?.[lang]) || t.role;
}
---

{/* Gate 22E — la sección de confianza "guía local" ya no desaparece
    cuando el tour no tiene relación de guía activa en Strapi: se
    muestra un estado genérico de equipo (sin nombre, sin foto de una
    persona concreta) en vez de nada. Mismo componente/markup para
    ambos estados — sólo cambia el encabezado y si se listan guías
    reales o una única tarjeta de equipo. */}
<section id="guides" class="py-12 md:py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">
          {hasGuides ? title : t.teamTitle}
        </h2>
        <p class="text-gray-600 text-base md:text-lg">
          {hasGuides ? subtitle : t.teamSubtitle}
        </p>
      </div>

      {hasGuides ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {guidesToShow.map((g) => (
            <article class="rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-card hover:shadow-lg transition">
              <div class="flex items-center justify-center mb-4">
                {g.fotoUrl ? (
                  <img
                    src={g.fotoUrl}
                    alt={guideImgAlt(g)}
                    width="120"
                    height="120"
                    loading="lazy"
                    decoding="async"
                    class="w-28 h-28 rounded-full object-cover ring-2 ring-yellow-300"
                  />
                ) : (
                  <div class="w-28 h-28 rounded-full bg-gray-100 ring-4 ring-yellow-200 flex items-center justify-center text-gray-400">
                    <Icon name="user" size={36} />
                  </div>
                )}
              </div>

              {/* Gate 22D — PUBLIC_GUIDE_NAME=HIDDEN: el nombre
                  personal del guía no se renderiza; sólo el rol
                  genérico. */}
              <h3 class="text-lg font-bold text-gray-900">
                {t.role}
              </h3>

              {g.idiomas.length > 0 && (
                <div class="flex flex-wrap justify-center gap-2 mt-4">
                  {g.idiomas.map((code) => (
                    <span class="text-[11px] px-2 py-0.5 rounded-full border border-gray-200 text-gray-600 bg-gray-50">
                      {normalizeLangTag(code)}
                    </span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      ) : (
        // Gate 22E — sin relación de guía activa: confianza a nivel de
        // equipo/marca, nunca la foto de un guía concreto (eso
        // implicaría, falsamente, que esa persona hace este tour) ni
        // un nombre inventado. Misma tarjeta visual que el estado con
        // guías, con el placeholder neutro ya existente.
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-card">
            <div class="flex items-center justify-center mb-4">
              <div class="w-28 h-28 rounded-full bg-gray-100 ring-4 ring-yellow-200 flex items-center justify-center text-gray-400">
                <Icon name="user" size={36} />
              </div>
            </div>
            <h3 class="text-lg font-bold text-gray-900">
              {t.role}
            </h3>
          </article>
        </div>
      )}

      <!-- Nota opcional (suave) -->
      {hasGuides && normalizedGuides.length > 4 && (
        <div class="text-center mt-8 text-sm text-gray-500">
          {lang === "es" && "En algunos horarios puede asignarse otro guía del equipo según disponibilidad."}
          {lang === "en" && "On some timeslots, another team guide may be assigned depending on availability."}
          {lang === "it" && "In alcune fasce orarie potrebbe essere assegnata un’altra guida del team in base alla disponibilità."}
          {lang === "fr" && "Sur certains créneaux, un autre guide de l’équipe peut être attribué selon la disponibilité."}
        </div>
      )}
    </div>
  </div>
</section>
