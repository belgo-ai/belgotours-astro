---
// src/components/booking/BookingSteps.astro

interface Props {
  currentStep: number;
  lang: string;
}

const { currentStep, lang } = Astro.props;

const steps = [
  { 
    number: 1, 
    label: {
      es: 'Fecha & Grupo',
      en: 'Date & Group', 
      it: 'Data & Gruppo',
      fr: 'Date & Groupe',
      pt: 'Data & Grupo'
    }
  },
  { 
    number: 2, 
    label: {
      es: 'Tus Datos',
      en: 'Your Details',
      it: 'I tuoi Dati', 
      fr: 'Vos Coordonnées',
      pt: 'Seus Dados'
    }
  },
  { 
    number: 3, 
    label: {
      es: 'Confirmar',
      en: 'Confirm',
      it: 'Conferma',
      fr: 'Confirmer', 
      pt: 'Confirmar'
    }
  }
];
---

<div class="flex justify-center px-4 pt-4 mb-2">
  <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 md:gap-6 text-sm md:text-base font-medium">

    {steps.map((step) => (
      <span
        data-booking-step={step.number}
        data-state={currentStep === step.number ? "current" : currentStep > step.number ? "done" : "todo"}
        aria-current={currentStep === step.number ? "step" : undefined}
        class={`bt-step transition-colors duration-200 ${
          currentStep === step.number
            ? "text-gray-900 font-semibold"
            : currentStep > step.number
            ? "text-gray-700"
            : "text-gray-500"
        }`}
      >
        <span class="bt-step-label">{step.label[lang as keyof typeof step.label] || step.label.es}</span>
      </span>
    ))}

  </div>
</div>
<style is:global>
  /* UX-03 — número de paso en círculo (pseudo-elemento: no cambia el
     texto del paso). Actual = negro de marca, hecho = amarillo,
     pendiente = contorno gris. data-state lo mantiene updateStepper(). */
  .bt-step {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
  }
  .bt-step::before {
    content: attr(data-booking-step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    flex-shrink: 0;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    border: 1.5px solid #9ca3af;
    color: #4b5563;
    background: #fff;
  }
  .bt-step[data-state="current"]::before {
    border-color: #0a0a0a;
    background: #0a0a0a;
    color: #fff;
  }
  .bt-step[data-state="done"]::before {
    border-color: #facc15;
    background: #facc15;
    color: #0a0a0a;
  }
  /* Móvil estrecho: una sola fila. Sólo el paso actual muestra su
     etiqueta; las demás quedan disponibles para lectores de pantalla. */
  @media (max-width: 439px) {
    .bt-step:not([data-state="current"]) .bt-step-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
