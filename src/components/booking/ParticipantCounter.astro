---
// src/components/booking/ParticipantCounter.astro
import Icon from "@/components/icons/Icon.astro";

interface Props {
  lang?: string;
  showMaxHint?: boolean;
}

// La regla de máx. 7 personas aplica a cualquier tipo de reserva (el
// componente no distingue), así que el hint debe verse siempre por
// defecto — antes sólo se mostraba si el padre lo pedía explícitamente,
// y BookingForm.astro nunca lo hacía, dejando el límite sin explicar
// en tours no-Free (B09 Gate 8, §12).
const { lang = "es", showMaxHint = true } = Astro.props as Props;
---

<!-- B10 Fase 1B: sin card propia (ya va dentro del panel); controles de
     44 px y estado desactivado sin amarillo -->
<div id="participantCounter" class="participant-counter space-y-4">

  <!-- Título (UX-03: el aviso de máximo pasa debajo si no cabe) -->
  <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
    <h3 class="font-semibold text-gray-900 text-base inline-flex items-center gap-1.5">
      <Icon name="users" />
      {lang === 'es' ? 'Participantes' :
       lang === 'en' ? 'Participants' :
       lang === 'it' ? 'Partecipanti' :
       lang === 'fr' ? 'Participants' :
       'Participantes'}
    </h3>

    {showMaxHint && (
  <span class="text-xs text-gray-500">
    {lang === "es"
      ? "Máx. 7 personas por reserva"
      : lang === "en"
      ? "Max. 7 people per booking"
      : lang === "it"
      ? "Max. 7 persone per prenotazione"
      : lang === "fr"
      ? "Max. 7 personnes par réservation"
      : "Max. 7"}
  </span>
)}
  </div>

  <!-- Adultos -->
  <div class="flex items-center justify-between">
    <div>
      <div class="font-medium text-gray-800">
        {lang === 'es' ? 'Adultos' :
         lang === 'en' ? 'Adults' :
         lang === 'it' ? 'Adulti' :
         lang === 'fr' ? 'Adultes' :
         'Adultos'}
      </div>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="decreaseAdults"
        aria-label={lang === "en" ? "Remove an adult" : lang === "it" ? "Rimuovi un adulto" : lang === "fr" ? "Retirer un adulte" : "Quitar un adulto"}
        class="bt-count-btn w-11 h-11 rounded-full bg-gray-100 text-gray-900 text-lg font-semibold hover:bg-gray-200 transition disabled:bg-gray-50 disabled:text-gray-300 disabled:cursor-not-allowed"
        disabled
      >
        −
      </button>

      <span id="adultsCount" class="w-7 text-center text-lg font-semibold text-gray-900 tabular-nums" aria-live="polite">
        1
      </span>

      <button
        type="button"
        id="increaseAdults"
        aria-label={lang === "en" ? "Add an adult" : lang === "it" ? "Aggiungi un adulto" : lang === "fr" ? "Ajouter un adulte" : "Añadir un adulto"}
        class="bt-count-btn w-11 h-11 rounded-full bg-yellow-400 text-gray-900 text-lg font-semibold hover:bg-yellow-300 transition disabled:bg-gray-50 disabled:text-gray-300 disabled:cursor-not-allowed"
      >
        +
      </button>
    </div>
  </div>

  <!-- Niños -->
  <div class="flex items-center justify-between">
    <div>
      <div class="font-medium text-gray-800">
        {lang === 'es' ? 'Niños (0–12)' :
         lang === 'en' ? 'Children (0–12)' :
         lang === 'it' ? 'Bambini (0–12)' :
         lang === 'fr' ? 'Enfants (0–12)' :
         'Niños'}
      </div>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="decreaseChildren"
        aria-label={lang === "en" ? "Remove a child" : lang === "it" ? "Rimuovi un bambino" : lang === "fr" ? "Retirer un enfant" : "Quitar un niño"}
        class="bt-count-btn w-11 h-11 rounded-full bg-gray-100 text-gray-900 text-lg font-semibold hover:bg-gray-200 transition disabled:bg-gray-50 disabled:text-gray-300 disabled:cursor-not-allowed"
        disabled
      >
        −
      </button>

      <span id="childrenCount" class="w-7 text-center text-lg font-semibold text-gray-900 tabular-nums" aria-live="polite">
        0
      </span>

      <button
        type="button"
        id="increaseChildren"
        aria-label={lang === "en" ? "Add a child" : lang === "it" ? "Aggiungi un bambino" : lang === "fr" ? "Ajouter un enfant" : "Añadir un niño"}
        class="bt-count-btn w-11 h-11 rounded-full bg-yellow-400 text-gray-900 text-lg font-semibold hover:bg-yellow-300 transition disabled:bg-gray-50 disabled:text-gray-300 disabled:cursor-not-allowed"
      >
        +
      </button>
    </div>
  </div>

</div>
<script>
// Estado de participantes seguro (sin pelearte con TS)
const bookingState =
  ((window as any).bookingState ??= {});

const participants =
  (bookingState.participants ??= { adults: 1, children: 0 });

document.addEventListener("DOMContentLoaded", () => {
  const adultsCount = document.getElementById("adultsCount");
  const childrenCount = document.getElementById("childrenCount");

  const decreaseAdults = document.getElementById("decreaseAdults");
  const increaseAdults = document.getElementById("increaseAdults");
  const decreaseChildren = document.getElementById("decreaseChildren");
  const increaseChildren = document.getElementById("increaseChildren");

  // Guard + aliases NO-null (esto es lo que TS sí respeta en closures)
  if (
    !(adultsCount instanceof HTMLElement) ||
    !(childrenCount instanceof HTMLElement) ||
    !(decreaseAdults instanceof HTMLButtonElement) ||
    !(increaseAdults instanceof HTMLButtonElement) ||
    !(decreaseChildren instanceof HTMLButtonElement) ||
    !(increaseChildren instanceof HTMLButtonElement)
  ) {
    return;
  }

  const adultsEl = adultsCount;
  const childrenEl = childrenCount;
  const decAdultsBtn = decreaseAdults;
  const incAdultsBtn = increaseAdults;
  const decChildrenBtn = decreaseChildren;
  const incChildrenBtn = increaseChildren;

  function updateCounts() {
    const total = participants.adults + participants.children;

    adultsEl.textContent = String(participants.adults);
    childrenEl.textContent = String(participants.children);

    decAdultsBtn.disabled = participants.adults <= 1;
    decChildrenBtn.disabled = participants.children <= 0;

    incAdultsBtn.disabled = total >= 7;
    incChildrenBtn.disabled = total >= 7;

    document.dispatchEvent(new CustomEvent("participantsUpdated"));
  }

  incAdultsBtn.addEventListener("click", () => {
    participants.adults++;
    updateCounts();
  });

  decAdultsBtn.addEventListener("click", () => {
    if (participants.adults > 1) {
      participants.adults--;
      updateCounts();
    }
  });

  incChildrenBtn.addEventListener("click", () => {
    participants.children++;
    updateCounts();
  });

  decChildrenBtn.addEventListener("click", () => {
    if (participants.children > 0) {
      participants.children--;
      updateCounts();
    }
  });

  updateCounts();
});
</script>