  }

  /* BOOKING-FORM-PERF-01 — paso 2: el formulario es una superficie
     neutra y cada campo una caja blanca con borde visible (≥3:1).
     Foco: borde negro + halo amarillo. Error: rojo, también si el
     campo tiene el foco. Las clases border-red-500/ring-* que pone
     bookingForm.ts siguen siendo el disparador del estado de error. */
  .bt-form-surface {
    background: #f5f5f3;
    border: 1px solid #e4e4e0;
    border-radius: 1rem;
    padding: 0.75rem;
    /* en móvil la superficie sale hacia el margen de la tarjeta para
       que los campos conserven su ancho */
    margin-inline: -0.75rem;
  }
  @media (min-width: 768px) {
    .bt-form-surface {
      padding: 1rem 1.25rem;
      margin-inline: 0;
    }
  }
  .bt-label {
    display: block;
    margin-bottom: 0.25rem;
