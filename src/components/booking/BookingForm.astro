---
import BookingSteps from "./BookingSteps.astro";
import BookingCalendar from "./BookingCalendar.astro";
import ParticipantCounter from "./ParticipantCounter.astro";



interface Props {
  tour: any;
  lang: string;
}

const { tour, lang } = Astro.props;
const isFreeTour = tour?.pagoLibre === true || tour?.precio === 0;
const isPrivateTour = tour?.tipo_tour === "privado";
const isSpecialTour = tour?.tipo_tour === "especial"; // chocolate & cerveza


const titleByLang: Record<string, string> = {
  es: "Reserva tu experiencia",
  en: "Book your experience",
  it: "Prenota la tua esperienza",
  fr: "Réservez votre expérience",
  pt: "Reserve sua experiência",
};

const contactTitleByLang: Record<string, string> = {
  es: "Tus datos de contacto",
  en: "Your contact details",
  it: "I tuoi dati di contatto",
  fr: "Vos coordonnées",
  pt: "Seus dados de contato",
};

const confirmTitleByLang: Record<string, string> = {
  es: "Confirma tu reserva",
  en: "Confirm your booking",
  it: "Conferma la prenotazione",
  fr: "Confirmez votre réservation",
  pt: "Confirme sua reserva",
};

const bookingSummaryByLang: Record<string, string> = {
  es: "Resumen de tu reserva",
  en: "Booking summary",
  it: "Riepilogo prenotazione",
  fr: "Résumé de la réservation",
  pt: "Resumo da reserva",
};

const privacyTextByLang: Record<string, string> = {
  es: "Acepto los términos y condiciones y la política de privacidad",
  en: "I accept the terms and conditions and privacy policy",
  it: "Accetto i termini e condizioni e la privacy policy",
  fr: "J'accepte les conditions générales et la politique de confidentialité",
  pt: "Aceito os termos e condições e a política de privacidade",
};

const marketingTextByLang: Record<string, string> = {
  es: "Quiero recibir información útil y recomendaciones de BelgoTours por email o WhatsApp.",
  en: "I want to receive useful information and recommendations from BelgoTours by email or WhatsApp.",
  it: "Desidero ricevere informazioni utili e consigli da BelgoTours via email o WhatsApp.",
  fr: "Je souhaite recevoir des informations utiles et des recommandations de BelgoTours par email ou WhatsApp.",
  pt: "Quero receber informações úteis e recomendações da BelgoTours por email ou WhatsApp.",
};

const howHeardLabelByLang: Record<string, string> = {
  es: "¿Cómo nos conociste?",
  en: "How did you hear about us?",
  it: "Come ci hai conosciuto?",
  fr: "Comment nous avez-vous connus ?",
  pt: "Como nos conheceu?",
};

// ✅ Base de la API de Strapi compilada en build (NO se usa import.meta.env en el navegador)
const STRAPI_API_BASE =
  (import.meta.env.PUBLIC_STRAPI_URL || "http://localhost:1337/api").replace(/\/$/, "");
---

<div
  id="bookingForm"
  data-lang={lang}
  data-api={STRAPI_API_BASE}
  class="max-w-4xl mx-auto bg-white rounded-2xl"
>
  <!-- CABECERA -->
<!-- B10 Fase 1B: cabecera compacta (antes ~177 px en móvil): más sitio
     para fechas y horarios en el primer pantallazo del panel -->
<div class="bg-white border-b border-gray-200 px-4 py-2.5 md:px-7 md:py-5 rounded-t-2xl">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 md:gap-4">

    <!-- Título principal -->
    <div>
      <h2 class="text-lg md:text-2xl font-bold text-gray-900 leading-tight">
        {titleByLang[lang] || titleByLang.es}
      </h2>
      <p class="text-gray-600 text-sm line-clamp-1 md:line-clamp-2 mt-0.5">
        {tour?.titulo}
      </p>
    </div>

    <!-- Badge informativo (duración + tipo de tour) -->
    {(tour?.duracion || tour?.precio === 0) && (
      <!-- Badge informativo -->
<div class="flex items-center">
  <div class="inline-flex items-center gap-2 bg-gray-100 text-gray-800 px-3 py-1 md:px-4 md:py-1.5 rounded-full text-xs md:text-sm font-medium">

    {/* DURACIÓN */}
    {!isPrivateTour && tour?.duracion && (
      <span>
        {(() => {
          const total = Number(tour.duracion);
          if (Number.isNaN(total)) return "";
          const h = Math.floor(total / 60);
          const m = total % 60;
          if (h && m) return `${h} h ${m} min`;
          if (h) return `${h} h`;
          return `${m} min`;
        })()}
      </span>
    )}

    {!isPrivateTour && tour?.duracion && <span class="opacity-40">•</span>}

    {/* TIPO / PRECIO */}
    <span>
      {isFreeTour && (
        lang === "es"
          ? "Free tour · pago libre"
          : lang === "en"
          ? "Free tour · pay what you want"
          : lang === "it"
          ? "Free tour · offerta libera"
          : "Free tour"
      )}

      {isPrivateTour && tour?.precio && (
        <>
          {lang === "es" && `Desde ${tour.precio} € / grupo`}
          {lang === "en" && `From €${tour.precio} / group`}
          {lang === "it" && `Da ${tour.precio} € / gruppo`}
          {lang === "fr" && `À partir de ${tour.precio} € / groupe`}
        </>
      )}

      {isSpecialTour && tour?.precio && (
        <>
          {lang === "es" && `${tour.precio} € · pago al guía`}
          {lang === "en" && `€${tour.precio} · pay the guide`}
          {lang === "it" && `${tour.precio} € · pagamento alla guida`}
          {lang === "fr" && `${tour.precio} € · paiement au guide`}
        </>
      )}
    </span>

  </div>
</div>

    )}

  </div>
</div>

  <BookingSteps currentStep={1} lang={lang} />

  <!-- Errores de reserva (rechazo backend, red, sesión caducada) —
       reemplaza alert() nativo (B09 Gate 9, §8/§9) -->
  <div
    id="bookingErrorBanner"
    class="hidden mx-5 md:mx-7 mt-4 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800"
    role="alert"
  >
    <p id="bookingErrorText"></p>
    <button
      type="button"
      id="bookingErrorBackBtn"
      class="hidden mt-2 font-semibold text-red-900 underline underline-offset-2"
    >
      {lang === "es" && "← Elegir otra fecha y hora"}
      {lang === "en" && "← Choose another date and time"}
      {lang === "it" && "← Scegli un'altra data e ora"}
      {lang === "fr" && "← Choisir une autre date et heure"}
      {!["es", "en", "it", "fr"].includes(lang) && "← Choose another date and time"}
    </button>
  </div>

  <div class="px-4 pt-3 md:px-7 md:pt-5 space-y-6 pb-28 bt-steps-body">
    <!-- PASO 1: FECHA / HORARIO / PARTICIPANTES -->
    <div id="step1" class="booking-step active space-y-3 md:space-y-5">
        <h3 class="text-lg md:text-xl font-bold text-gray-900">
  {lang === "es" && "Selecciona fecha y hora"}
  {lang === "en" && "Select date and time"}
  {lang === "it" && "Seleziona data e orario"}
  {lang === "fr" && "Choisissez date et horaire"}
</h3>
    {/* UX-01 final: el aviso del free tour sobre el email se movió junto
        al campo de email (paso 2); aquí sólo quedan los de privado/especial */}
    {(isPrivateTour || isSpecialTour) && (
    <p class="text-xs text-gray-500">
  {isPrivateTour && (
    lang === "es"
      ? "Te contactaremos para definir fecha y precio."
      : lang === "en"
      ? "We’ll contact you to define date and price."
      : lang === "it"
      ? "Ti contatteremo per definire data e prezzo."
      : "Nous vous contacterons pour définir la date et le prix."
  )}

  {isSpecialTour && (
    lang === "es"
      ? "Recibirás confirmación inmediata por email."
      : lang === "en"
      ? "You’ll receive instant email confirmation."
      : lang === "it"
      ? "Riceverai conferma immediata via email."
      : "Confirmation immédiate par email."
  )}
</p>
    )}


      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-0 items-start">
        <div class="min-w-0 lg:pr-7">
          <BookingCalendar tour={tour} lang={lang} />
        </div>

        <!-- Free tour: la regla de máx. 7 se explica una sola vez (el texto
             completo de abajo); en el resto la da el propio contador -->
        <div class="min-w-0 space-y-4 border-t border-gray-200 pt-5 lg:border-t-0 lg:pt-0 lg:border-l lg:pl-7">
          <ParticipantCounter lang={lang} showMaxHint={!isFreeTour} />

{isFreeTour && (
  <div class="space-y-2">
    <p class="text-xs text-gray-500">
  {lang === "es" && "Máx. 7 personas por reserva. Si sois más, podéis hacer otra reserva con un segundo email."}
  {lang === "en" && "Max. 7 people per booking. If you’re more, please make a second booking with another email."}
  {lang === "it" && "Massimo 7 persone per prenotazione. Se siete di più, effettuate una seconda prenotazione con un'altra email."}
  {lang === "fr" && "Maximum 7 personnes par réservation. Si vous êtes plus nombreux, effectuez une seconde réservation avec un autre email."}
</p>

    <p class="text-sm font-medium text-gray-700">
  {lang === "es" && "La mayoría de viajeros contribuye alrededor de 15 € por persona."}
  {lang === "en" && "Most travelers contribute around €15 per person."}
  {lang === "it" && "La maggior parte dei viaggiatori contribuisce circa 15 € a persona."}
  {lang === "fr" && "La plupart des voyageurs contribuent environ 15 € par personne."}
</p>
  </div>
)}

        </div>
      </div>
    </div>

<!-- PASO 2: DATOS DEL CLIENTE -->
<div id="step2" class="booking-step hidden space-y-4">
  <h3 class="text-2xl font-bold text-gray-900">
    {contactTitleByLang[lang] || contactTitleByLang.es}
  </h3>

  <div class="bg-white border border-gray-200 rounded-xl p-3 text-sm text-gray-700 space-y-1">
  <div class="flex justify-between">
    <span>{lang === "es" ? "Fecha" : "Date"}</span>
    <span class="font-semibold" id="step2SummaryDate">--</span>
  </div>
  <div class="flex justify-between">
    <span>{lang === "es" ? "Hora" : "Time"}</span>
    <span class="font-semibold" id="step2SummaryTime">--</span>
  </div>
  <div class="flex justify-between">
    <span>{lang === "es" ? "Personas" : "People"}</span>
    <span class="font-semibold" id="step2SummaryParticipants">--</span>
  </div>
</div>

    {/* UX-01B: la intro "Solo usaremos tus datos…" se retiró; repetía la
        ayuda del campo de email, que queda como única explicación */}

  <div class="bt-form-surface grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-4">
    <!-- Nombre -->
    <div>
      <label for="firstName" class="bt-label">
        {lang === "es" && "Nombre"}
        {lang === "en" && "First name"}
        {lang === "it" && "Nome"}
        {lang === "fr" && "Prénom"} *
      </label>
      <input
        id="firstName"
        name="firstName"
        type="text"
        required
        autocomplete="given-name"
        class="bt-field"
        placeholder={lang === "es" ? "Ej: María" : "John"}
      />
    </div>

    <!-- Apellidos -->
    <div>
      <label for="lastName" class="bt-label">
        {lang === "es" && "Apellidos"}
        {lang === "en" && "Last name"}
        {lang === "it" && "Cognome"}
        {lang === "fr" && "Nom de famille"} *
      </label>
      <input
        id="lastName"
        name="lastName"
        type="text"
        required
        autocomplete="family-name"
        class="bt-field"
        placeholder={lang === "es" ? "Ej: González López" : "Doe"}
      />
    </div>

    <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-4">
  <!-- País PRIMERO -->
  <div>
    <label for="customerCountry" class="bt-label">
      {lang === "es" && "País"}
      {lang === "en" && "Country"}
      {lang === "it" && "Paese"}
      {lang === "fr" && "Pays"} *
    </label>
    <!-- BOOKING-UX-02: lista local de países (placeAutocomplete.ts), sin
         red. autocomplete="country-name" (antes "off", B09 Gate 9) deja
         que el autorrelleno del navegador complete el formulario de una
         vez; la lista propia sólo se abre al teclear, nunca con un valor
         autorrellenado. -->
    <div class="relative">
      <input
        id="customerCountry"
        name="customerCountry"
        type="text"
        required
        autocomplete="country-name"
        autocapitalize="words"
        spellcheck="false"
        class="bt-field"
        placeholder={lang === "es" ? "España, México, Italia..." : lang === "en" ? "Spain, Mexico, Italy..." : lang === "it" ? "Spagna, Messico, Italia..." : "Espagne, Mexique, Italie..."}
      />
      <div id="countrySuggestions"
           class="absolute z-20 bg-white border border-gray-200 rounded-xl shadow-lg w-full mt-1 hidden max-h-60 overflow-y-auto text-sm">
      </div>
    </div>
  </div>

  <!-- Ciudad SEGUNDO -->
  <div>
    <label for="customerCity" class="bt-label">
      {lang === "es" && "Ciudad"}
      {lang === "en" && "City"}
      {lang === "it" && "Città"}
      {lang === "fr" && "Ville"} *
    </label>
    <!-- BOOKING-UX-02: texto libre con el autorrelleno del navegador.
         Sin lista propia: la política de Nominatim público no permite
         autocompletado (antes se consultaba en cada tecla) -->
    <input
      id="customerCity"
      name="customerCity"
      type="text"
      required
      autocomplete="address-level2"
      autocapitalize="words"
      spellcheck="false"
      class="bt-field"
      placeholder={lang === "es" ? "Madrid, Roma, Bruselas..." : lang === "en" ? "Madrid, Rome, Brussels..." : lang === "it" ? "Madrid, Roma, Bruxelles..." : "Madrid, Rome, Bruxelles..."}
    />
  </div>
</div>

    <!-- Teléfono (Intl Tel Input profesional) -->
<div class="md:col-span-2">
  <label for="customerPhone" class="bt-label">
    {lang === "es" && "Móvil (WhatsApp recomendado)"}
    {lang === "en" && "Mobile phone (WhatsApp recommended)"}
    {lang === "it" && "Cellulare (WhatsApp consigliato)"}
    {lang === "fr" && "Téléphone portable (WhatsApp recommandé)"} *
  </label>

  <div class="relative">
    <input
      id="customerPhone"
      name="customerPhone"
      type="tel"
      required
      inputmode="tel"
      autocomplete="tel"
      aria-describedby="phoneError"
      class="bt-field"
    />

    <!-- Mensaje error teléfono -->
    <p
      id="phoneError"
      class="text-xs text-red-700 mt-1 hidden"
    >
      {lang === "es" && "Revisa el número o el prefijo del país"}
      {lang === "en" && "Check the number or the country code"}
      {lang === "it" && "Controlla il numero o il prefisso del paese"}
      {lang === "fr" && "Vérifiez le numéro ou l’indicatif du pays"}
      {lang === "pt" && "Verifique o número ou o indicativo do país"}
    </p>
  </div>
</div>

    <!-- Email -->
    <div>
      <label for="customerEmail" class="bt-label">
        {lang === "es" && "Correo electrónico"}
        {lang === "en" && "Email address"}
        {lang === "it" && "Indirizzo email"}
        {lang === "fr" && "Adresse email"} *
      </label>
      <input
        id="customerEmail"
        name="customerEmail"
        type="email"
        required
        autocomplete="email"
        inputmode="email"
        class="bt-field"
        placeholder="email@ejemplo.com"
        aria-describedby="customerEmailHelp"
      />
      {/* Única explicación del uso de los datos en el paso 2 (UX-01B):
          para todos los tours con reserva directa */}
      <p id="customerEmailHelp" class="text-xs text-gray-600 mt-1.5">
        {lang === "es"
          ? "Solo para enviarte la confirmación y detalles del tour."
          : lang === "en"
          ? "Only to send your booking confirmation and details."
          : lang === "it"
          ? "Solo per inviarti conferma e dettagli del tour."
          : "Uniquement pour envoyer la confirmation du tour."}
      </p>
    </div>

    <!-- Confirmar Email -->
    <div>
      <label for="customerEmailConfirm" class="bt-label">
        {lang === "es" && "Confirma tu correo"}
        {lang === "en" && "Confirm your email"}
        {lang === "it" && "Conferma la tua email"}
        {lang === "fr" && "Confirmez votre email"} *
      </label>
      <input
        id="customerEmailConfirm"
        name="customerEmailConfirm"
        type="email"
        required
        autocomplete="off"
        inputmode="email"
        aria-describedby="emailMismatch"
        class="bt-field"
        placeholder={lang === "es" ? "Repite tu correo" : "Repeat your email"}
      />
      <p id="emailMismatch" class="text-xs text-red-700 mt-1 hidden">
        {lang === "es" && "Los correos no coinciden."}
        {lang === "en" && "Emails do not match."}
        {lang === "it" && "Le email non corrispondono."}
        {lang === "fr" && "Les adresses email ne correspondent pas."}
        {lang === "pt" && "Os emails não coincidem."}
      </p>
    </div>





    <!-- Marketing -->
    <div class="flex items-start gap-3 md:col-span-2">
      <input
        id="marketingConsent"
        name="marketingConsent"
        type="checkbox"
        class="mt-0.5 h-5 w-5 shrink-0 accent-gray-900"
      />
      <label for="marketingConsent" class="text-sm text-gray-700 cursor-pointer">
        {marketingTextByLang[lang] || marketingTextByLang.es}
      </label>
    </div>
  </div>
</div>

<!-- PASO 3: RESUMEN + TÉRMINOS -->
    <div id="step3" class="booking-step hidden space-y-4">
      <h3 class="text-xl font-bold text-gray-900">
        {confirmTitleByLang[lang] || confirmTitleByLang.es}
      </h3>

      <!-- BOOKING-UX-02: resumen compacto (los mismos datos y ids que antes)
           para que "Confirmar reserva" quede a la vista sin scroll en
           móvil; comentarios y "cómo nos conociste" pasan debajo -->
      <section
        class="bg-gray-50 rounded-2xl border border-gray-200 px-4 py-3"
        aria-labelledby="step3SummaryTitle"
      >
        <h4 id="step3SummaryTitle" class="sr-only">
          {bookingSummaryByLang[lang] || bookingSummaryByLang.es}
        </h4>
        <p class="text-sm font-semibold text-gray-900 leading-snug">
          {tour?.titulo}
        </p>
        <dl class="bt-summary-line mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-700">
          <div>
            <dt class="sr-only">{lang === "es" ? "Fecha" : "Date"}</dt>
            <dd class="font-semibold text-gray-900" id="summaryDate">--/--/----</dd>
          </div>
          <div>
            <dt class="sr-only">{lang === "es" ? "Horario" : "Time"}</dt>
            <dd class="font-semibold text-gray-900" id="summaryTime">--:--</dd>
          </div>
          <div>
            <dt class="sr-only">{lang === "es" ? "Participantes" : "Participants"}</dt>
            <dd id="summaryParticipants">--</dd>
          </div>
          <div>
            <dt class="sr-only">{lang === "es" ? "Idioma" : "Language"}</dt>
            <dd class="uppercase">{lang}</dd>
          </div>
        </dl>
      </section>

      <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            id="agreeToTerms"
            name="agreeToTerms"
            required
            class="mt-0.5 h-5 w-5 shrink-0 accent-gray-900"
          />
          <span class="text-sm text-gray-700">
            {privacyTextByLang[lang] || privacyTextByLang.es} *
          </span>
        </label>

      <!-- CONFIRMAR RESERVA / SOLICITUD -->
<button
  id="confirmBooking"
  type="button"
  class="w-full bg-yellow-400 hover:bg-yellow-300 text-gray-900 font-extrabold py-4 px-8 rounded-xl transition duration-300 transform hover:scale-105 shadow-lg disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed disabled:transform-none"
  disabled
>
  {isPrivateTour && (
    <>
      {lang === "es" && "Enviar solicitud"}
      {lang === "en" && "Send request"}
      {lang === "it" && "Invia richiesta"}
      {lang === "fr" && "Envoyer la demande"}
      {!["es", "en", "it", "fr"].includes(lang) && "Send request"}
    </>
  )}

  {!isPrivateTour && (
    <>
      {lang === "es" && "Confirmar reserva"}
      {lang === "en" && "Confirm booking"}
      {lang === "it" && "Conferma prenotazione"}
      {lang === "fr" && "Confirmer la réservation"}
      {!["es", "en", "it", "fr"].includes(lang) && "Confirm booking"}
    </>
  )}
</button>
<p class="text-xs text-gray-500 text-center mt-3">
  {isFreeTour && (
    <>
      {lang === "es" && "Reserva gratuita. Cancelación sin coste. Confirmación inmediata por email."}
      {lang === "en" && "Free booking. Free cancellation. Instant email confirmation."}
      {lang === "it" && "Prenotazione gratuita. Cancellazione gratuita. Conferma immediata via email."}
      {lang === "fr" && "Réservation gratuite. Annulation gratuite. Confirmation immédiate par email."}
    </>
  )}

  {isPrivateTour && (
    <>
      {lang === "es" && "Sin pago ahora. Te contactaremos para definir fecha y precio final."}
      {lang === "en" && "No payment now. We will contact you to define final date and price."}
      {lang === "it" && "Nessun pagamento ora. Ti contatteremo per definire data e prezzo finale."}
      {lang === "fr" && "Aucun paiement maintenant. Nous vous contacterons pour définir la date et le prix final."}
    </>
  )}

  {isSpecialTour && (
    <>
      {lang === "es" && "Pago directo al guía el día del tour."}
      {lang === "en" && "Pay the guide directly on the day of the tour."}
      {lang === "it" && "Pagamento diretto alla guida il giorno del tour."}
      {lang === "fr" && "Paiement directement au guide le jour du tour."}
    </>
  )}
</p>

<p class="text-xs text-gray-500 text-center">
          {lang === "es" &&
            "Al confirmar, recibirás un email automático con todos los detalles y un mensaje preparado para compartir por WhatsApp."}
          {lang === "en" &&
            "After confirming, you will receive an automatic email with all details and a pre-filled message to share on WhatsApp."}
        </p>

<div class="space-y-3 pt-1">
        <!-- Comentarios opcionales -->
      <details class="text-sm text-gray-600 cursor-pointer">
        <summary class="hover:text-gray-900 transition">
          {lang === "es" ? "¿Algo que debamos saber?" :
           lang === "en" ? "Anything we should know?" :
           lang === "it" ? "Qualcosa che dovremmo sapere?" :
           "Quelque chose à savoir?"} (opcional)
        </summary>
        <textarea
          id="customerComments"
          name="customerComments"
          rows="2"
          class="mt-2 w-full p-2.5 border border-gray-200 rounded-xl text-sm text-gray-600 focus:border-gray-400 focus:outline-none resize-none"
          placeholder={lang === "es" ? "Ej: viajamos con niños, silla de ruedas..." : "E.g. traveling with children, wheelchair..."}
        ></textarea>
      </details>

      <!-- Cómo nos conociste — campo de marketing, no bloquea -->
      <details class="text-sm text-gray-600 cursor-pointer">
