    min-height: 3rem;
    padding: 0.625rem 0.875rem;
    font-size: 1rem;
    line-height: 1.5rem;
    color: #111827;
    background: #fff;
    border: 1px solid #8a8f98;
    border-radius: 0.75rem;
    box-shadow: 0 1px 2px rgba(17, 24, 39, 0.05);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .bt-field::placeholder {
    color: #6b7280;
    opacity: 1;
  }
  .bt-field:hover {
    border-color: #4b5563;
  }
  .bt-field:focus {
