    border-color: #dc2626;
    box-shadow: 0 0 0 1px #dc2626;
  }
  .bt-field.border-red-500:focus,
  .bt-field[aria-invalid="true"]:focus {
    box-shadow: 0 0 0 1px #dc2626, 0 0 0 4px rgba(250, 204, 21, 0.7);
  }
  /* BOOKING-UX-02: "fecha · hora · personas · idioma" en una línea; el
     separador es decorativo (texto alternativo vacío) */
  .bt-summary-line > div {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .bt-summary-line > div:not(:last-child)::after {
    content: "·" / "";
    color: #9ca3af;
  }
  /* intl-tel-input envuelve el teléfono en .iti (inline-block por
     defecto): sin esto el campo quedaba más estrecho que los demás */
  #step2 :global(.iti) {
    display: block;
    width: 100%;
  }

 /* B10 Fase 1B: por encima de 768 px la barra queda fija al pie del área
    con scroll del panel ("Continuar" siempre a la vista en escritorio,
    también con poca altura); hasta 768 px sigue fixed como antes */
 @media (min-width: 769px) {
  #bookingNav {
    position: sticky;
    /* hasta el borde del área con scroll: el panel tiene 1rem (+ zona
       segura) de padding inferior y el contenido asomaba por debajo */
    bottom: calc(-1rem - env(safe-area-inset-bottom));
    z-index: 5;
    background: #fff;
    /* a sangre dentro del formulario (padding lateral de 1.75rem) */
    margin: 1.5rem -1.75rem 0;
    padding: 0.75rem 1.75rem calc(0.75rem + 1rem + env(safe-area-inset-bottom));
    border-bottom-left-radius: 1rem;
    border-bottom-right-radius: 1rem;
  }
  .bt-steps-body {
    padding-bottom: 0;
  }
 }

 @media (max-width: 768px) {
