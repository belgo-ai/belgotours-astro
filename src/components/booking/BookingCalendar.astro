---
/**
 * BookingCalendar.astro — conectado a Strapi (SSR)
 * UI refinada BelgoTours · sin tocar lógica
 */

const API =
  import.meta.env.PUBLIC_STRAPI_URL || "http://localhost:1337/api";

interface Props {
  tour?: any;
  lang?: string;
}

/* -------------------------
   Tipos internos seguros
-------------------------- */

type Lang = "es" | "en" | "it" | "fr";

type Horario = {
  id: number;
  fecha: string;
  hora: string;
  cupoDisponible: number;
  cupoMaximo: number;
  cupoOcupado: number;
};

const { tour = {}, lang = "es" } = Astro.props as Props;

/* Fallback seguro idioma */
const safeLang: Lang = (["es", "en", "it", "fr"] as const).includes(
  lang as Lang
)
  ? (lang as Lang)
  : "es";

const tourId =
  tour?.id ||
  tour?.strapiId ||
  tour?.documentId ||
  tour?.attributes?.id ||
  3;

/* -------------------------
   Textos UI tipados
-------------------------- */

const TEXTS: Record<
  Lang,
  {
    selectDate: string;
    selectTime: string;
    noTimes: string;
    maxPeople: string;
    calendarOpenLabel: string;
    calendarCloseLabel: string;
    legendAvailable: string;
    legendToday: string;
    prevMonth: string;
    nextMonth: string;
  }
> = {
  es: {
    selectDate: "Selecciona una fecha",
    selectTime: "Selecciona un horario",
    noTimes: "No hay horarios para esta fecha",
    maxPeople: "Plazas disponibles",
    calendarOpenLabel: "Ver calendario completo",
    calendarCloseLabel: "Ocultar calendario",
    legendAvailable: "Disponible",
    legendToday: "Hoy",
    prevMonth: "Mes anterior",
    nextMonth: "Mes siguiente",
  },
  en: {
    selectDate: "Select a date",
    selectTime: "Select a time",
    noTimes: "No times available for this date",
    maxPeople: "Available spots",
    calendarOpenLabel: "See full calendar",
    calendarCloseLabel: "Hide calendar",
    legendAvailable: "Available",
    legendToday: "Today",
    prevMonth: "Previous month",
    nextMonth: "Next month",
  },
  it: {
    selectDate: "Seleziona una data",
    selectTime: "Seleziona un orario",
    noTimes: "Nessun orario disponibile per questa data",
    maxPeople: "Posti disponibili",
    calendarOpenLabel: "Vedi calendario completo",
    calendarCloseLabel: "Nascondi calendario",
    legendAvailable: "Disponibile",
    legendToday: "Oggi",
    prevMonth: "Mese precedente",
    nextMonth: "Mese successivo",
  },
  fr: {
    selectDate: "Choisissez une date",
    selectTime: "Choisissez un horaire",
    noTimes: "Aucun horaire disponible pour cette date",
    maxPeople: "Places disponibles",
    calendarOpenLabel: "Voir le calendrier complet",
    calendarCloseLabel: "Masquer le calendrier",
    legendAvailable: "Disponible",
    legendToday: "Aujourd'hui",
    prevMonth: "Mois précédent",
    nextMonth: "Mois suivant",
  },
};

const texts = TEXTS[safeLang];

// F01 (B09 Gate 1): un tour de Bruselas ocurre en hora de Bruselas.
// "Hoy" no puede depender de la zona horaria del runtime del
// servidor (Netlify Functions usa UTC por defecto) — se ancla
// explícitamente a Europe/Brussels vía Intl (sin dependencia nueva,
// DST-safe de forma nativa). Mismo criterio que el cliente (más
// abajo) y que el backend (BUSINESS_ZONE en direct-booking.js).
function todayISO() {
  return new Date().toLocaleDateString("sv-SE", {
    timeZone: "Europe/Brussels",
  });
}

async function getHorariosByTourId(
  id: number | string
): Promise<Horario[]> {
  /*
   * Strapi conserva páginas técnicas limitadas para
   * proteger la API, pero el calendario recorre todas
   * las páginas. No existe un límite funcional total
   * para los horarios futuros del tour.
   */
  const transportPageSize = 100;
  const allHorarios: Horario[] = [];
  const seenIds = new Set<number>();

  let page = 1;

  while (true) {
    const params = new URLSearchParams();

    params.set("populate", "*");
    params.set(
      "filters[tour][id][$eq]",
      String(id)
    );
    params.set(
      "filters[fecha][$gte]",
      todayISO()
    );
    params.set(
      "filters[disponible][$eq]",
      "true"
    );

    params.set(
      "pagination[page]",
      String(page)
    );
    params.set(
      "pagination[pageSize]",
      String(transportPageSize)
    );

    params.set("sort[0]", "fecha:asc");
    params.set("sort[1]", "hora:asc");
    params.set("sort[2]", "id:asc");

    const res = await fetch(
      `${API}/horarios?${params.toString()}`,
      {
        headers: {
          Accept: "application/json",
        },
      }
    );

    if (!res.ok) {
      throw new Error(
        `No se pudieron cargar los horarios `
        + `(HTTP ${res.status}, página ${page}).`
      );
    }

    const json = await res.json();

    const pageItems = Array.isArray(json?.data)
      ? json.data
      : [];

    let addedOnPage = 0;

    for (const h of pageItems) {
      const a = h.attributes ?? h;

      const horarioId = Number(
        h.id ?? a.id
      );

      if (
        !Number.isInteger(horarioId)
        || horarioId <= 0
        || seenIds.has(horarioId)
      ) {
        continue;
      }

      const max = Number(
        a.cupoMaximo ?? 25
      );

      const ocup = Number(
        a.cupoOcupado ?? 0
      );

      seenIds.add(horarioId);

      allHorarios.push({
        id: horarioId,
        fecha: a.fecha,
        hora: a.hora,
        cupoDisponible:
          Math.max(0, max - ocup),
        cupoMaximo: max,
        cupoOcupado: ocup,
      });

      addedOnPage += 1;
    }

    const pagination =
      json?.meta?.pagination ?? {};

    const pageCount = Number(
      pagination.pageCount ?? 0
    );

    const reachedReportedLastPage =
      Number.isInteger(pageCount)
      && pageCount > 0
      && page >= pageCount;

    const reachedShortPage =
      pageItems.length
      < transportPageSize;

    const repeatedOrEmptyPage =
      pageItems.length === 0
      || addedOnPage === 0;

    if (
      reachedReportedLastPage
      || reachedShortPage
      || repeatedOrEmptyPage
    ) {
      break;
    }

    page += 1;
  }

  return allHorarios;
}

const horariosRaw = await getHorariosByTourId(tourId);
const horarios = horariosRaw.filter(
  (h: Horario) => h.cupoDisponible > 0
);
const fechasDisponibles = [
  ...new Set(horarios.map((h: Horario) => h.fecha)),
] as string[];

const firstDate = fechasDisponibles[0] ?? todayISO();
const lastDate = fechasDisponibles[fechasDisponibles.length - 1] ?? firstDate;
---

<div class="calendar-2026 space-y-8" data-lang={lang}>
  <!-- Fecha inteligente -->
<div class="space-y-3">

  <label class="block font-semibold text-gray-800">
    {texts.selectDate}
  </label>

  <!-- Pills rápidas (con fade de borde para insinuar scroll horizontal) -->
  <div class="relative">
    <div
    id="quickDates"
    class="flex gap-2 overflow-x-auto md:flex-wrap md:overflow-visible no-scrollbar scroll-smooth"
    style="scroll-snap-type: x mandatory;"
  ></div>
    <div class="quick-dates-fade md:hidden" aria-hidden="true"></div>
  </div>

  <!-- Toggle calendario visual -->
  <button
  type="button"
  id="toggleCalendar"
  aria-expanded="false"
  aria-controls="calendarPanel"
  data-label-open={texts.calendarOpenLabel}
  data-label-close={texts.calendarCloseLabel}
  class="mt-2 inline-flex items-center justify-center gap-2 px-4 py-2 rounded-full border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:border-yellow-400 hover:bg-yellow-50 transition"
>
    {texts.calendarOpenLabel}
  </button>

  <!-- Calendario visual compacto: sólo se conocen como AVAILABLE las
       fechas presentes en fechasDisponibles (dato real, ya calculado
       en SSR sobre el total de horarios futuros, sin muestreo) — todo
       lo demás dentro del rango se marca UNAVAILABLE, nunca inventado -->
  <div
    id="calendarPanel"
    class="hidden mt-3 border border-gray-200 rounded-2xl p-4 bg-white shadow-sm max-w-xs"
    role="group"
    aria-label={texts.selectDate}
  >
    <div class="flex items-center justify-between mb-3">
      <button
        type="button"
        id="calendarPrevMonth"
        aria-label={texts.prevMonth}
        class="w-8 h-8 rounded-full flex items-center justify-center text-gray-500 hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent"
      >‹</button>
      <span id="calendarMonthLabel" class="font-semibold text-gray-800 text-sm capitalize"></span>
      <button
        type="button"
        id="calendarNextMonth"
        aria-label={texts.nextMonth}
        class="w-8 h-8 rounded-full flex items-center justify-center text-gray-500 hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent"
      >›</button>
    </div>
    <div id="calendarGrid" class="grid grid-cols-7 gap-1" role="grid"></div>
    <div class="flex items-center gap-3 mt-3 pt-3 border-t border-gray-100 text-[11px] text-gray-500">
      <span class="flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 inline-block" aria-hidden="true"></span>
        {texts.legendAvailable}
      </span>
      <span class="flex items-center gap-1">
        <span class="w-2.5 h-2.5 rounded ring-2 ring-gray-400 inline-block" aria-hidden="true"></span>
        {texts.legendToday}
      </span>
    </div>
  </div>

  <!-- Estado interno de fecha seleccionada — nunca visible, la UI real
       es quickDates + calendarPanel -->
  <input
    id="fechaPicker"
    type="date"
    class="hidden"
    value={firstDate}
    min={firstDate}
    max={lastDate}
  />

</div>

  <!-- Horarios -->
  <div>
    <label class="block font-semibold mb-3 text-gray-800">
      {texts.selectTime}
    </label>

    <div
      id="horariosContainer"
      class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-3"
    ></div>
  </div>
</div>

<script type="application/json" id="horarios-data" set:html={JSON.stringify(horarios)}></script>
<script type="application/json" id="fechas-data" set:html={JSON.stringify(fechasDisponibles)}></script>

<script>
import { DateTime } from "luxon";

// F01 (B09 Gate 1): zona horaria comercial única — un tour de
// Bruselas ocurre en hora de Bruselas, nunca en la del dispositivo
// del visitante. Luxon con IANA timezone resuelve CET/CEST (DST) de
// forma nativa, sin offsets manuales. Mismo criterio que el SSR
// (arriba, vía Intl) y que el backend (BUSINESS_ZONE en
// direct-booking.js) — misma regla, tres puntos de aplicación.
const BUSINESS_ZONE = "Europe/Brussels";

function brusselsNow(): DateTime {
  return DateTime.now().setZone(BUSINESS_ZONE);
}

function brusselsTodayISO(): string {
  return brusselsNow().toISODate() as string;
}

// Regla de negocio única: reservable únicamente si slotStart > now,
// en Europe/Brussels. Sin cutoff adicional. Datos inválidos → no
// reservable (fail-safe), igual que el backend.
function isSlotBookable(fecha: string, hora: string, now = brusselsNow()): boolean {
  if (!fecha || !hora) return false;
  const slot = DateTime.fromISO(`${fecha}T${hora}`, { zone: BUSINESS_ZONE });
  if (!slot.isValid) return false;
  return slot > now;
}

document.addEventListener("DOMContentLoaded", () => {
  const horarios = JSON.parse(
    document.getElementById("horarios-data")?.textContent || "[]"
  );

  const fechasDisponibles = JSON.parse(
  document.getElementById("fechas-data")?.textContent || "[]"
);

  const fechaPickerEl = document.getElementById("fechaPicker");
const contenedorEl = document.getElementById("horariosContainer");
const wrapper = document.querySelector(".calendar-2026");

if (!(fechaPickerEl instanceof HTMLInputElement)) return;
if (!(contenedorEl instanceof HTMLElement)) return;

/* Variables tipadas finales */
const fechaPicker: HTMLInputElement = fechaPickerEl;
const contenedor: HTMLElement = contenedorEl;

const quickDatesContainer = document.getElementById("quickDates");
const toggleBtn = document.getElementById("toggleCalendar");
const currentLang =
  wrapper instanceof HTMLElement && wrapper.dataset?.lang
    ? wrapper.dataset.lang
    : "es";

function formatShortDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString(currentLang, {
    day: "2-digit",
    month: "short",
  });
}

// Único cálculo de "qué fechas son realmente reservables" — usado
// tanto por las quick dates como por el calendario visual, para que
// ambos coincidan siempre (B09 Gate 8).
function computeValidDates(): string[] {
  const todayStr = brusselsTodayISO();

  let validDates = [...fechasDisponibles];

  // 🔥 comprobar si hoy aún tiene horarios futuros (Europe/Brussels)
  const todayHasFutureTimes = horarios.some((h: any) => {
    if (h.fecha !== todayStr) return false;
    return isSlotBookable(h.fecha, h.hora);
  });

  // si hoy no tiene horarios futuros → eliminarlo
  if (!todayHasFutureTimes) {
    validDates = validDates.filter((f) => f !== todayStr);
  }

  // cualquier fecha estrictamente anterior a "hoy" en Brussels nunca es
  // válida, aunque llegara en fechasDisponibles por alguna vía
  // (defensa en profundidad además del filtro SSR)
  return validDates.filter((f) => f >= todayStr);
}

// Selección de fecha unificada — quick dates, calendario visual y
// selección inicial pasan todos por aquí, para que el estado de
// reserva nunca quede contradictorio entre fecha y horario (B09 Gate
// 8, §11): cambiar de fecha SIEMPRE invalida cualquier horario
// previamente elegido, sin depender del evento "change" de un
// <input type="date"> que ya no es visible ni interactivo.
function selectDate(fecha: string, isInitial: boolean) {
  fechaPicker.value = fecha;

  const state = ((window as any).bookingState = (window as any).bookingState || {});
  state.selectedDate = null;
  state.selectedTime = null;
  state.horarioId = null;
  (window as any).updateBookingNavigation?.();

  document
    .querySelectorAll("#quickDates button")
    .forEach((el) => el.classList.remove("border-yellow-400", "bg-yellow-100"));

  const matchingQuickBtn = quickDatesContainer?.querySelector(
    `button[data-date="${fecha}"]`
  ) as HTMLElement | null;

  if (matchingQuickBtn) {
    matchingQuickBtn.classList.add("border-yellow-400", "bg-yellow-100");
    matchingQuickBtn.scrollIntoView({
      behavior: "smooth",
      inline: "center",
      block: "nearest",
    });
  }

  renderCalendarGrid();
  renderHorarios(fecha);

  if (!isInitial) {
    setTimeout(() => {
      const horariosEl = document.getElementById("horariosContainer");
      if (!horariosEl) return;
      const panel = document.querySelector(".panel-content");
      if (panel) {
        const offset = horariosEl.getBoundingClientRect().top
          - panel.getBoundingClientRect().top
          + panel.scrollTop - 20;
        panel.scrollTo({ top: offset, behavior: "smooth" });
      } else {
        horariosEl.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }, 500);
  }
}

function renderQuickDates() {
  if (!quickDatesContainer) return;

  quickDatesContainer.innerHTML = "";

  const validDates = computeValidDates();

  // PUBLISHED != HAS_FUTURE_AVAILABILITY (B09 Gate 8, §9): si no hay
  // ninguna fecha real, no quedan botones que auto-disparar el
  // primer renderHorarios() — sin este mensaje explícito, el panel
  // quedaba completamente en blanco (confirmado en datos reales de
  // producción: tours publicados sin horarios futuros existen hoy).
  if (validDates.length === 0) {
    const noAvailabilityMsg =
      currentLang === "en"
        ? "No times available"
        : currentLang === "it"
        ? "Nessun orario disponibile"
        : currentLang === "fr"
        ? "Aucun horaire disponible"
        : "No hay horarios disponibles";

    const emptyMsg = document.createElement("p");
    emptyMsg.className = "text-sm text-gray-500";
    emptyMsg.textContent = noAvailabilityMsg;
    quickDatesContainer.appendChild(emptyMsg);

    if (contenedor) {
      contenedor.innerHTML = `<p class="text-sm text-gray-400">${noAvailabilityMsg}</p>`;
    }
    toggleBtn?.classList.add("hidden");
    return;
  }

  toggleBtn?.classList.remove("hidden");

  const limitedDates = validDates.slice(0, 10);

  limitedDates.forEach((fecha: string, index: number) => {
    const btn = document.createElement("button");
    btn.type = "button";

    let label = formatShortDate(fecha);
const todayISO = brusselsTodayISO();
const tomorrowISO = brusselsNow().plus({ days: 1 }).toISODate() as string;

if (fecha === todayISO) {
  label =
    currentLang === "en"
      ? "Today"
      : currentLang === "it"
      ? "Oggi"
      : currentLang === "fr"
      ? "Aujourd’hui"
      : "Hoy";
} else if (fecha === tomorrowISO) {
  label =
    currentLang === "en"
      ? "Tomorrow"
      : currentLang === "it"
      ? "Domani"
      : currentLang === "fr"
      ? "Demain"
      : "Mañana";
}

    btn.className =
  "px-4 py-2 rounded-full border border-gray-300 text-sm bg-white hover:border-yellow-400 transition whitespace-nowrap flex-shrink-0";
btn.style.scrollSnapAlign = "start";
btn.dataset.date = fecha;

    btn.textContent = label;

    btn.onclick = () => selectDate(fecha, !!btn.dataset.initial);

    quickDatesContainer.appendChild(btn);

    if (index === 0) {
  btn.dataset.initial = "true";
  setTimeout(() => {
    btn.click();
    btn.dataset.initial = "";
  }, 0);
}
  });
}

// ==========================================================
// CALENDARIO VISUAL COMPACTO (B09 Gate 8)
// Único dato usado para distinguir AVAILABLE/UNAVAILABLE es
// fechasDisponibles (real, calculado en SSR sobre el total de
// horarios futuros — sin muestreo, sin llamadas adicionales). No se
// añade ninguna dependencia: reutiliza Luxon, ya presente en este
// mismo componente para la lógica de zona horaria F01.
// ==========================================================
const calendarPanel = document.getElementById("calendarPanel");
const calendarGrid = document.getElementById("calendarGrid");
const calendarMonthLabel = document.getElementById("calendarMonthLabel");
const calendarPrevBtn = document.getElementById("calendarPrevMonth");
const calendarNextBtn = document.getElementById("calendarNextMonth");

const localeMap: Record<string, string> = {
  es: "es-ES",
  en: "en-GB",
  it: "it-IT",
  fr: "fr-FR",
};
const calendarLocale = localeMap[currentLang] || "es-ES";

const firstAvailableDT = DateTime.fromISO(
  fechasDisponibles[0] || brusselsTodayISO(),
  { zone: BUSINESS_ZONE }
);
const lastAvailableDT = DateTime.fromISO(
  fechasDisponibles[fechasDisponibles.length - 1] || brusselsTodayISO(),
  { zone: BUSINESS_ZONE }
);
const minMonth = firstAvailableDT.startOf("month");
const maxMonth = lastAvailableDT.startOf("month");

let viewMonth = minMonth;

function weekdayLabels(): string[] {
  // Lunes conocido (2024-01-01) como ancla, sólo para nombrar días de
  // la semana en el locale correcto — no depende del año real.
  const anchorMonday = DateTime.fromObject(
    { year: 2024, month: 1, day: 1 },
    { zone: "utc" }
  );
  return Array.from({ length: 7 }, (_, i) =>
    anchorMonday.plus({ days: i }).setLocale(calendarLocale).toFormat("ccc")
  );
}

function renderCalendarGrid() {
  if (!calendarGrid || !calendarMonthLabel) return;

  calendarGrid.innerHTML = "";
  calendarMonthLabel.textContent = viewMonth
    .setLocale(calendarLocale)
    .toFormat("LLLL yyyy");

  if (calendarPrevBtn instanceof HTMLButtonElement) {
    calendarPrevBtn.disabled = viewMonth <= minMonth;
  }
  if (calendarNextBtn instanceof HTMLButtonElement) {
    calendarNextBtn.disabled = viewMonth >= maxMonth;
  }

  const validDates = new Set(computeValidDates());
  const todayStr = brusselsTodayISO();

  weekdayLabels().forEach((w) => {
    const el = document.createElement("div");
    el.className = "text-[11px] font-semibold text-gray-400 text-center py-1 uppercase";
    el.setAttribute("aria-hidden", "true");
    el.textContent = w;
    calendarGrid.appendChild(el);
  });

  const daysInMonth = viewMonth.daysInMonth || 30;
  // Luxon: weekday 1=lunes...7=domingo — semana empieza en lunes
  const leadingBlanks = viewMonth.weekday - 1;

  for (let i = 0; i < leadingBlanks; i++) {
    calendarGrid.appendChild(document.createElement("div"));
  }

  for (let day = 1; day <= daysInMonth; day++) {
    const dt = viewMonth.set({ day });
    const iso = dt.toISODate() as string;
    const isPast = iso < todayStr;
    const isAvailable = !isPast && validDates.has(iso);
    const isToday = iso === todayStr;
    const isSelected = iso === fechaPicker.value;

    const btn = document.createElement("button");
    btn.type = "button";
    btn.textContent = String(day);
    btn.setAttribute(
      "aria-label",
      dt.setLocale(calendarLocale).toFormat("cccc d LLLL")
    );
    if (isSelected) btn.setAttribute("aria-selected", "true");
    if (isToday) btn.setAttribute("aria-current", "date");

    const base =
      "calendar-day relative h-9 w-full rounded-lg text-sm flex items-center justify-center transition";

    if (isSelected) {
      btn.className = `${base} bg-yellow-400 text-gray-900 font-bold`;
    } else if (isAvailable) {
      btn.className = `${base} bg-white text-gray-900 font-medium border border-gray-200 hover:border-yellow-400 hover:bg-yellow-50 cursor-pointer`;
    } else {
      btn.className = `${base} text-gray-300 cursor-not-allowed`;
      btn.disabled = true;
    }

    if (isToday && !isSelected) {
      btn.classList.add("ring-2", "ring-gray-400");
    }

    if (isAvailable && !isSelected) {
      const dot = document.createElement("span");
      dot.className = "absolute bottom-1 w-1.5 h-1.5 rounded-full bg-yellow-500";
      dot.setAttribute("aria-hidden", "true");
      btn.appendChild(dot);
    }

    if (isAvailable) {
      btn.addEventListener("click", () => selectDate(iso, false));
    }

    calendarGrid.appendChild(btn);
  }
}

calendarPrevBtn?.addEventListener("click", () => {
  if (viewMonth <= minMonth) return;
  viewMonth = viewMonth.minus({ months: 1 });
  renderCalendarGrid();
});

calendarNextBtn?.addEventListener("click", () => {
  if (viewMonth >= maxMonth) return;
  viewMonth = viewMonth.plus({ months: 1 });
  renderCalendarGrid();
});

renderQuickDates();

// F01 §7 (B09 Gate 1) — sesión obsoleta: si la pestaña permanece
// abierta y el reloj avanza (incluida medianoche Brussels), se
// reconcilia al recuperar visibilidad/foco. Sin polling — sólo en
// esos dos eventos, mecanismo mínimo.
let lastKnownBrusselsToday = brusselsTodayISO();

function reconcileBrusselsTime() {
  const currentToday = brusselsTodayISO();

  if (currentToday !== lastKnownBrusselsToday) {
    // Cambió el día comercial (p.ej. cruzó medianoche Brussels) —
    // reconstruir quick dates desde cero, que ya vuelve a
    // seleccionar la fecha inicial correcta.
    lastKnownBrusselsToday = currentToday;
    renderQuickDates();
    return;
  }

  // Mismo día: si la fecha actualmente mostrada es "hoy", reevaluar
  // sus horarios por si alguno acaba de pasar.
  if (fechaPicker.value === currentToday) {
    renderHorarios(currentToday);
  }
}

document.addEventListener("visibilitychange", () => {
  if (document.visibilityState === "visible") reconcileBrusselsTime();
});
window.addEventListener("focus", reconcileBrusselsTime);

if (toggleBtn instanceof HTMLButtonElement) {
  toggleBtn.addEventListener("click", () => {
    const willOpen = calendarPanel?.classList.contains("hidden");
    calendarPanel?.classList.toggle("hidden");
    toggleBtn.setAttribute("aria-expanded", String(!!willOpen));
    toggleBtn.textContent = willOpen
      ? toggleBtn.dataset.labelClose ?? toggleBtn.textContent ?? ""
      : toggleBtn.dataset.labelOpen ?? toggleBtn.textContent ?? "";

    if (willOpen) {
      let target = DateTime.fromISO(fechaPicker.value, {
        zone: BUSINESS_ZONE,
      }).startOf("month");
      if (!target.isValid) target = minMonth;
      if (target < minMonth) target = minMonth;
      if (target > maxMonth) target = maxMonth;
      viewMonth = target;
      renderCalendarGrid();
    }
  });
}

  const noTimesText =
  currentLang === "en"
    ? "No times available"
    : currentLang === "it"
    ? "Nessun orario disponibile"
    : currentLang === "fr"
    ? "Aucun horaire disponible"
    : "No hay horarios disponibles";

const spotsText =
  currentLang === "en"
    ? "spots available"
    : currentLang === "it"
    ? "posti disponibili"
    : currentLang === "fr"
    ? "places disponibles"
    : "plazas disponibles";

function getUrgencyText(spots: number): string | null {
  if (spots === 1) {
    return currentLang === "en"
      ? "Last spot available"
      : currentLang === "it"
      ? "Ultimo posto disponibile"
      : currentLang === "fr"
      ? "Dernière place disponible"
      : "Última plaza disponible";
  }

  if (spots <= 3) {
    return currentLang === "en"
      ? "Few spots left"
      : currentLang === "it"
      ? "Pochi posti rimasti"
      : currentLang === "fr"
      ? "Peu de places restantes"
      : "Quedan pocas plazas";
  }

  return null;
 }  
 
     function renderHorarios(fecha: string) {
  // 🔹 Limpiar inmediatamente (sin setTimeout)
  contenedor.innerHTML = "";
  contenedor.style.opacity = "0";
  contenedor.style.transition = "opacity 0.18s ease";

  requestAnimationFrame(() => {
    contenedor.style.opacity = "1";
  });

  const todayStr = brusselsTodayISO();

  // 1️⃣ Filtrar por fecha
  let delDia = horarios.filter((h: any) => h.fecha === fecha);

  // 2️⃣ Si es hoy, filtrar horarios pasados (Europe/Brussels, F01)
  if (fecha === todayStr) {
    const before = delDia;
    delDia = delDia.filter((h: any) => isSlotBookable(h.fecha, h.hora));

    // Si el horario que el usuario ya tenía seleccionado acaba de
    // pasar (sesión abierta durante un rato, F01 §7 escenario A),
    // limpiar la selección para que no quede "elegido" un slot que
    // el backend rechazaría — obliga a elegir uno nuevo.
    const stillHasSelected = delDia.some(
      (h: any) => Number(h.id) === (window as any).bookingState?.horarioId
    );
    const hadSelected = before.some(
      (h: any) => Number(h.id) === (window as any).bookingState?.horarioId
    );
    if (hadSelected && !stillHasSelected && (window as any).bookingState) {
      (window as any).bookingState.selectedDate = null;
      (window as any).bookingState.selectedTime = null;
      (window as any).bookingState.horarioId = null;
      (window as any).updateBookingNavigation?.();
    }
  }

  // 3️⃣ Si no hay horarios válidos → auto avanzar
  if (!delDia.length) {
  const currentIndex = fechasDisponibles.indexOf(fecha);

  if (
    currentIndex !== -1 &&
    currentIndex < fechasDisponibles.length - 1
  ) {
    const siguienteFecha = fechasDisponibles[currentIndex + 1];

    contenedor.innerHTML = `
      <p class="text-sm text-gray-500 mb-3">
        ${
          currentLang === "en"
            ? "No tours available that day. Showing next available tour."
            : currentLang === "it"
            ? "Nessun tour disponibile quel giorno. Mostriamo il prossimo disponibile."
            : currentLang === "fr"
            ? "Aucun tour ce jour-là. Affichage du prochain disponible."
            : "No hay tours ese día. Mostrando el próximo disponible."
        }
      </p>
    `;

    setTimeout(() => {
      fechaPicker.value = siguienteFecha;
      renderHorarios(siguienteFecha);
    }, 900);

    return;
  }

  contenedor.innerHTML =
    `<p class='text-sm text-gray-500'>${noTimesText}</p>`;
  return;
}

  // 4️⃣ Render horarios válidos
  const maxVisible = 4;
  let expanded = false;

  function createHorarioButton(h: any) {
    const btn = document.createElement("button");

    const urgencyMessage = getUrgencyText(h.cupoDisponible);

    const urgencia = urgencyMessage
      ? `<div class='text-xs text-yellow-600 mt-1'>${urgencyMessage}</div>`
      : "";

    btn.className = `
  time-slot
  border border-gray-300
  rounded-xl
  p-4
  text-center
  bg-white
  hover:border-yellow-400
  hover:bg-yellow-50
  transition
  cursor-pointer
  shadow-sm
`;

    btn.innerHTML = `
  <div class="text-lg font-bold text-gray-900">
    ${h.hora}
  </div>

  <div class="text-xs text-gray-500 mt-1">
    ${h.cupoDisponible} ${spotsText}
  </div>

  ${urgencia}

  <div class="text-xs text-gray-400 mt-2">
    ${
      currentLang === "en"
        ? "Select"
        : currentLang === "it"
        ? "Seleziona"
        : currentLang === "fr"
        ? "Sélectionner"
        : "Seleccionar"
    }
  </div>
`;

    btn.onclick = () => {
      document.querySelectorAll(".time-slot").forEach((el) => {
        el.classList.remove("border-yellow-400", "bg-yellow-100");
      });

      btn.classList.add("border-yellow-400", "bg-yellow-100");

      window.bookingState = window.bookingState || {};
      window.bookingState.selectedDate = h.fecha;
      window.bookingState.selectedTime = h.hora;
      window.bookingState.horarioId = Number(h.id);
      setTimeout(() => {
  if ((window as any).updateBookingNavigation) {
    (window as any).updateBookingNavigation();
  }
}, 0);

      window.dispatchEvent(new CustomEvent("dateSelected"));
      window.dispatchEvent(new CustomEvent("timeSelected"));

      // Un solo evento GA4 por selección real de horario — dateSelected +
      // timeSelected se disparan juntos desde este mismo bloque, así que
      // sólo se engancha aquí (no en ambos listeners) para no duplicar.
      (window as any).BTAnalytics?.trackEvent("select_availability_date", {
        ...((window as any).__BT_TOUR__ || {}),
        selected_date: h.fecha,
        selected_time: h.hora,
      });

      setTimeout(() => {
  const participantSection = document.getElementById("participantCounter") ||
    document.querySelector(".participant-counter");
  if (!participantSection) return;
  const panel = document.querySelector(".panel-content");
  if (panel) {
    const offset = participantSection.getBoundingClientRect().top
      - panel.getBoundingClientRect().top
      + panel.scrollTop - 20;
    panel.scrollTo({ top: offset, behavior: "smooth" });
  } else {
    participantSection.scrollIntoView({ behavior: "smooth", block: "center" });
  }
}, 350);
      
    };

    return btn;
  }

  // 🔹 Render primeros visibles
  delDia.slice(0, maxVisible).forEach((h: any, index: number) => {
    const btn = createHorarioButton(h);
    contenedor.appendChild(btn);


   });

  // 🔹 Si hay más → crear toggle
  if (delDia.length > maxVisible) {
    const hiddenContainer = document.createElement("div");
    hiddenContainer.className =
      "col-span-full hidden grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-3";

    delDia.slice(maxVisible).forEach((h: any) => {
      const btn = createHorarioButton(h);
      hiddenContainer.appendChild(btn);
    });

    const toggleBtn = document.createElement("button");
    toggleBtn.type = "button";
    toggleBtn.className =
  "col-span-full mt-4 inline-flex items-center justify-center px-4 py-2 rounded-full border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:border-yellow-400 hover:bg-yellow-50 transition";

    toggleBtn.textContent =
      currentLang === "en"
        ? "See more times"
        : currentLang === "it"
        ? "Vedi più orari"
        : currentLang === "fr"
        ? "Voir plus d'horaires"
        : "Ver más horarios";

    toggleBtn.onclick = () => {
      expanded = !expanded;
      hiddenContainer.classList.toggle("hidden");

      toggleBtn.textContent = expanded
        ? currentLang === "en"
          ? "Hide times"
          : currentLang === "it"
          ? "Nascondi orari"
          : currentLang === "fr"
          ? "Masquer les horaires"
          : "Ocultar horarios"
        : currentLang === "en"
        ? "See more times"
        : currentLang === "it"
        ? "Vedi più orari"
        : currentLang === "fr"
        ? "Voir plus d'horaires"
        : "Ver más horarios";
    };

    contenedor.appendChild(toggleBtn);
    contenedor.appendChild(hiddenContainer);
  }
}

});
</script>


