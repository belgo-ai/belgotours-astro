<script>
(function () {
  const content = document.getElementById("description-content");
  const btn = document.getElementById("description-toggle-btn");
  if (!content || !btn) return;

  function checkOverflow() {
    if (content!.classList.contains("expanded")) return;
    const overflowing = content!.scrollHeight > content!.clientHeight + 4;
    if (overflowing) {
      btn!.classList.remove("hidden");
    } else {
      content!.classList.remove("description-clamp");
      btn!.classList.add("hidden");
    }
  }

  btn.addEventListener("click", () => {
    const isOpen = btn!.getAttribute("aria-expanded") === "true";
    content!.classList.toggle("expanded", !isOpen);
    btn!.setAttribute("aria-expanded", String(!isOpen));
    btn!.textContent = (isOpen ? btn!.dataset.labelMore : btn!.dataset.labelLess) ?? "";
  });

  requestAnimationFrame(checkOverflow);
  window.addEventListener("resize", () => {
    if (btn!.getAttribute("aria-expanded") !== "true") checkOverflow();
  });
})();
</script>

