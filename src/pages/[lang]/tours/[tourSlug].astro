const dt = disclosureTexts[lang] || disclosureTexts.es;

/* =========================================================
HERO COPY + FORMATTING
========================================================= */
function formatDuration(value: number | null | undefined): string {
if (value === null || value === undefined) return "";
const n = Number(value);
if (Number.isNaN(n)) return "";
const h = Math.floor(n / 60);
const m = n % 60;
if (!h) return `${m} min`;
if (!m) return `${h} h`;
return `${h} h ${m} min`;
}

const durationLabel = formatDuration(tour.duracion);
// Gate — nombre completo del idioma del tour, no el código de 2
// letras (antes `String(tour.idioma).toUpperCase()` habría dado "ES"/
// "EN"/etc. si el campo hubiera estado poblado; el objetivo es que se
// lea "Español"/"English" de un vistazo).
const TOUR_LANGUAGE_LABELS: Record<string, string> = {
  es: "Español",
  en: "English",
  it: "Italiano",
  fr: "Français",
};
const langLabel = tour.idioma ? (TOUR_LANGUAGE_LABELS[tour.idioma] || String(tour.idioma).toUpperCase()) : "";
const cityLabel = tour.ciudad ? String(tour.ciudad).toUpperCase() : "";

// Subtitle fallback (NO es heading)
const heroSubtitleFallback: Record<
  Lang,
  {
    free: string;
    fixed: string;
    private: string;
    special: string;
  }
> = {
  es: {
    free: "Historia, arquitectura y rincones ocultos con guías locales.",
    fixed: "Una experiencia cuidada con guías locales.",
    private: "Tour privado a tu ritmo con guía local.",
    special: "Una experiencia única y deliciosa en Bélgica.",
  },
  en: {
    free: "History, architecture and hidden corners with local guides.",
    fixed: "A curated experience with local guides.",
    private: "Private tour at your pace with a local guide.",
    special: "A unique and delicious Belgian experience.",
  },
  it: {
    free: "Storia, architettura e angoli nascosti con guide locali.",
    fixed: "Un’esperienza curata con guide locali.",
    private: "Tour privato al tuo ritmo con guida locale.",
    special: "Un’esperienza belga unica e gustosa.",
  },
  fr: {
    free: "Histoire, architecture et coins cachés avec des guides locaux.",
    fixed: "Une expérience soignée avec des guides locaux.",
    private: "Visite privée à votre rythme avec un guide local.",
    special: "Une expérience belge unique et savoureuse.",
  }
};
const subtitleKey = isPrivate ? "private" : isSpecial ? "special" : isFree ? "free" : "fixed";

const heroSubtitle =
(tour.subtitulo && tour.subtitulo.trim()) ||
heroSubtitleFallback[lang]?.[subtitleKey] ||
heroSubtitleFallback.es.free;

const heroClaim =
(tour.claimHero && String(tour.claimHero).trim()) ||
heroSubtitle;

// Pricing hero
const heroPriceTitle = isPrivate
? ui.presupuesto
: isFree
? ui.aportacionLibre
: `${tour.precioBase}${tour.moneda}`;

const heroPriceNote = isPrivate
? ui.consultaWhatsApp
: isFree
? ui.tuDecides
: ui.pagoAlGuia;

// CTA mode
const heroCtaMode = bookingMode === "request" ? "private-request" : "booking";
const heroCtaText = ui.reservar;
const heroCtaMicro = isPrivate ? ui.microPrivate : "";

/* =========================================================
MAP LINKS
========================================================= */
const mapsUrl = (() => {
if (tour.lat && tour.lng) {
return `https://www.google.com/maps?q=${tour.lat},${tour.lng}`;
}
if (tour.puntoEncuentro) {
return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(tour.puntoEncuentro)}`;
}
return "";
})();

/* =========================================================
REVIEWS (schema gating)
========================================================= */


/* =========================================================
SEO (title/description/canonical)
========================================================= */
const rawTitle = (tour.seoTitle && tour.seoTitle.trim()) || tour.titulo;
const metaTitle = rawTitle.includes('BelgoTours')
  ? rawTitle
  : `${rawTitle} | BelgoTours`;

// Limpiar HTML de seo_description para meta tag. Gate C01: seo_description
// en Strapi es contenido largo (varios párrafos), no una meta description
// corta — un slice(0, 160) puro cortaba a mitad de frase (evidencia: GSC
// mostró CTR del flagship colapsando de 5.71% a 0.55% en los meses
// posteriores a introducir este slice, con posición estable/mejorando en
// el mismo período — snippet roto, no problema de ranking). Ahora corta en
// el límite de frase más cercano por debajo de 160 chars; si ninguna frase
// cabe, corta en el límite de palabra más cercano y añade "…".
const stripHtml = (html: string) => {
  const text = html
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .replace(/\s+([.,;:!?])/g, '$1')
    .trim();
  if (text.length <= 160) return text;
  const truncated = text.slice(0, 160);
  const lastSentenceEnd = truncated.lastIndexOf('. ');
  if (lastSentenceEnd > 60) return truncated.slice(0, lastSentenceEnd + 1);
  const lastSpace = truncated.lastIndexOf(' ');
  return `${truncated.slice(0, lastSpace > 0 ? lastSpace : 160)}…`;
};

const metaDescription =
  (tour.seoDescription && tour.seoDescription.trim())
    ? stripHtml(tour.seoDescription)
    : heroSubtitle;

// Sin trailing slash (política de páginas hoja — B06C). El sitemap
// oficial, el hreflang self-referente de esta misma página y la
// inmensa mayoría de reglas de `_redirects` ya usan esta forma para
// tours; antes solo el canonical usaba "/" al final, contradiciendo
// al propio hreflang self de la página (SEO-002).
const canonicalUrl =
(tour.seoCanonical && tour.seoCanonical.trim()) ||
`https://belgotours.com/${lang}/tours/${tour.slug}`;

// Product/Offer describen el tour en sí (precio, disponibilidad,
// idioma) y son datos siempre reales/disponibles — no dependen de si
// hay reviews. AggregateRating/Review SÍ dependen de datos reales de
// reviews y solo se añaden cuando reviewCount > 0 (nunca se fabrican
// — B06D / SEO-004: antes todo el bloque, incluido Product/Offer,
// estaba condicionado a reviewCount > 0, así que un tour con cero
// reviews no tenía NINGÚN structured data, ni siquiera el que sí
// tenía datos reales disponibles).
const tourSchema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${canonicalUrl}#product`,
  url: canonicalUrl,
  name: tour.titulo,
  description: metaDescription,
  image: tour.heroMedia?.imagen
    ? [tour.heroMedia.imagen]
    : undefined,

  brand: {
    "@type": "Organization",
    name: "BelgoTours",
    url: "https://belgotours.com"
  },

  provider: {
    "@type": "Organization",
    name: "BelgoTours",
    url: "https://belgotours.com"
  },

  areaServed: {
    "@type": "City",
    name: tour.ciudad === "bruselas" ? "Brussels" : "Bruges"
  },

  inLanguage: lang,

  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: tour.precioBase && tour.precioBase > 0
      ? String(tour.precioBase)
      : "0",
    availability: "https://schema.org/InStock",
    url: canonicalUrl
  },
};

if (reviewCount > 0) {
  tourSchema.aggregateRating = {
    "@type": "AggregateRating",
    ratingValue: rating.toFixed(1),
    reviewCount: reviewCount,
    bestRating: "5",
    worstRating: "1"
  };

  tourSchema.review = topReviews.map((r: any) => ({
    "@type": "Review",
    author: {
      "@type": "Person",
      name: r.nombre || "Traveler"
    },
    datePublished: r.fecha,
    reviewBody: r.comentario || "",
    reviewRating: {
      "@type": "Rating",
      ratingValue: String(r.rating),
      bestRating: "5",
      worstRating: "1"
    }
  }));
}

/* =========================================================
BREADCRUMBS (jerarquía real: Home -> Tour, sin categorías
inexistentes como "/brussels/" — B06D)
========================================================= */
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "BelgoTours",
      item: `https://belgotours.com/${lang}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: tour.titulo,
      item: canonicalUrl,
    },
  ],
};

/* =========================================================
RELATED TOURS (internal linking — B06D, SEO-007)
B09 Gate 15 — derivado del catálogo real de Strapi (nunca cruza
idioma/CONTENT_LANGUAGE). Publicar un tour nuevo en Strapi lo hace
aparecer aquí automáticamente, sin tocar este archivo.
========================================================= */
const RELATED_SECTION_TITLE: Record<string, string> = {
  es: "También te puede interesar",
  en: "Discover more BelgoTours experiences",
  it: "Potrebbero interessarti anche",
  fr: "",
};

const catalogForLang = await getTourCatalog(lang as "es" | "en" | "it" | "fr");
const relatedCatalogItems = getRelatedTours(catalogForLang, {
  slug: tour.slug,
  ciudad: tour.ciudad,
  tipo_tour: tour.tipo_tour,
}, 3);
const relatedTours = relatedCatalogItems.map((t) => ({
  slug: t.slug,
  href: `/${lang}/tours/${t.slug}`,
  label: t.titulo,
}));
  ---

<Layout
title={metaTitle}
description={metaDescription}
canonical={canonicalUrl}
>
{tourSchema && (
<script type="application/ld+json" set:html={JSON.stringify(tourSchema)} />
)}
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<!-- 1) HEADER (global) -->
<div slot="header">
<TourHeader lang={lang} />
</div>

<!-- 2) HERO (dinámico desde Strapi) -->
<section 
  id="tour-hero"
  class="relative min-h-[70vh] md:min-h-screen flex items-center justify-center overflow-hidden">
<div class="absolute inset-0 z-0">
{tour.heroMedia?.video ? (
<video
class="w-full h-full object-cover"
src={tour.heroMedia.video}
autoplay
muted
loop
playsinline
/>
) : tour.heroMedia?.imagen ? (
<img
src={tour.heroMedia.imagen}
srcset={tour.heroMedia.imagenSrcSet || undefined}
sizes="100vw"
width={tour.heroMedia.imagenWidth || undefined}
height={tour.heroMedia.imagenHeight || undefined}
alt={tour.titulo}
class="w-full h-full object-cover"
