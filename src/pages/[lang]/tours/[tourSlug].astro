/* =========================================================
IMPORTANT: enable SSG prerender for getStaticPaths()
========================================================= */


/* =========================================================
STATIC PATHS
========================================================= */


/* =========================================================
FETCH TOUR
========================================================= */
const { tourSlug, lang: rawLang } = Astro.params;


type Lang = "es" | "en" | "it" | "fr";

// No hay contenido real de tours en portugués (ni en ningún otro idioma
// no soportado). No se hace fallback silencioso a español: un idioma no
// soportado en esta ruta responde 404 real, no 200 con contenido/idioma
// incorrectos (ver B06A / SEO-008).
if (!rawLang || !["es", "en", "it", "fr"].includes(rawLang)) {
  return new Response(null, { status: 404 });
}

const lang = rawLang as Lang;

const tourData = await getTourBySlug(tourSlug, lang);

if (!tourData) {
  return new Response(null, {
    status: 302,
    headers: { Location: `/${lang}/404/` },
  });
}

/* =========================================================
FETCH REVIEWS (para JSON-LD dinámico real)
========================================================= */
const STRAPI_API =
  import.meta.env.PUBLIC_STRAPI_URL ||
  process.env.PUBLIC_STRAPI_URL ||
  "https://api.belgotours.com/api";

let reviewsData = null;

try {
  const res = await fetch(
    `${STRAPI_API}/public/reviews-pro?tour=${tourSlug}&lang=${lang}`,
    {
      signal: AbortSignal.timeout(3000),
      headers: {
        "Accept": "application/json",
      },
    }
  );

  if (res.ok) {
    reviewsData = await res.json();
  } else {
    console.error("❌ Error HTTP reviews schema:", res.status);
  }
} catch (e) {
  console.error("❌ Error loading reviews schema", e);
}

/* =========================================================
NORMALIZE REVIEWS DATA
========================================================= */
const rating =
  Number(reviewsData?.summary?.rating) || 0;

const reviewCount =
  Number(reviewsData?.summary?.total) || 0;

const topReviews =
  Array.isArray(reviewsData?.reviews)
    ? reviewsData.reviews.slice(0, 3)
    : [];


// Compat Strapi v4/v5
const attrs = tourData.attributes ?? tourData;
const tourId = tourData.id ?? attrs?.id ?? null;

/* =========================================================
MEDIA HELPER (SAFE · STAGING & PROD)
========================================================= */
function mediaUrl(
  media: any,
  preferredSize: "large" | "medium" | "small" = "large"
): string {
  if (!media) return "";

  // Usamos SIEMPRE la base real que ya conoce Astro
  const apiBase =
    (import.meta.env.PUBLIC_STRAPI_URL || "")
      .replace(/\/api\/?$/, "")
      .replace(/\/$/, "");

  const path =
    media?.formats?.[preferredSize]?.url ||
    media?.formats?.medium?.url ||
    media?.formats?.small?.url ||
    media?.url ||
    "";

  // Si Strapi ya devuelve URL absoluta → la respetamos
  if (path.startsWith("http://") || path.startsWith("https://")) {
    return path;
  }

  // Si no, construimos URL segura (sin forzar protocolo)
  return path ? `${apiBase}${path}` : "";
}

// B09 Gate 12 — Strapi ya genera 4 tamaños reales por imagen
// (thumbnail/small/medium/large) pero el frontend sólo usaba uno fijo
// para todos los viewports. srcset real a partir de datos que ya
// llegan en la misma respuesta — sin generar ni pedir nada nuevo.
function mediaSrcSet(media: any): string {
  if (!media?.formats) return "";

  const apiBase =
    (import.meta.env.PUBLIC_STRAPI_URL || "")
      .replace(/\/api\/?$/, "")
      .replace(/\/$/, "");

  const abs = (u: string) =>
    u.startsWith("http://") || u.startsWith("https://") ? u : `${apiBase}${u}`;

  return (["thumbnail", "small", "medium", "large"] as const)
    .map((key) => media.formats[key])
    .filter((f: any) => f?.url && f?.width)
    .map((f: any) => `${abs(f.url)} ${f.width}w`)
    .join(", ");
}

/* =========================================================
NORMALIZATION
========================================================= */
const heroConfig = attrs.hero_config || {};
const heroMedia = attrs.hero_media || {};

// En tu Strapi schema aparece como repeatable:true (pero el JSON que pegaste NO tiene array).
// Para robustez: aceptamos objeto o array.
const elementosUnicosRaw =
attrs.elementos_unicos ?? attrs.elementosUnicos ?? null;

const elementosUnicos = Array.isArray(elementosUnicosRaw)
? elementosUnicosRaw[0] || {}
: (elementosUnicosRaw || {});

/* =========================================================
BUSINESS LOGIC
========================================================= */
const tipoTour = attrs.tipo_tour || "free"; // free | privado | especial

const bookingMode =
  attrs.booking_mode === "request" || attrs.booking_mode === "direct"
    ? attrs.booking_mode
    : tipoTour === "privado"
      ? "request"
      : "direct";

const reviewMode =
  attrs.review_mode === "manual" || attrs.review_mode === "auto"
    ? attrs.review_mode
    : bookingMode === "request"
      ? "manual"
      : "auto";

const isPrivate = bookingMode === "request";
const isSpecial = tipoTour === "especial";
const isFree = tipoTour === "free" && attrs.pago_libre === true;
const isFixed = !isPrivate && !isFree;

/* =========================================================
TOUR OBJECT (normalized)
========================================================= */
const tour = {
id: tourId,
slug: attrs.slug,
titulo: attrs.titulo || "Sin título",
subtitulo: attrs.subtitulo || "",
seoH1: attrs.seo_h1 || "",
claimHero: attrs.claim_hero || "",
descripcion: attrs.descripcion || "",
ciudad: attrs.ciudad || "", // bruselas|brujas
tipo_tour: tipoTour, // free|privado|especial — para eventos GA4 (ver ANALYTICS_PLAN.md)
// Gate — TOUR_LANGUAGE real (idioma en el que se GUÍA este tour),
// no CONTENT_LANGUAGE (el idioma de la página que se está viendo).
// El schema de Tour no tiene un campo idioma/idiomas propio (nunca lo
// tuvo) — el chip que lo mostraba en el hero llevaba tiempo mudo por
// leer un campo inexistente. La fuente real y ya canónica es
// `locale`, el mismo campo de Strapi que ya usa SearchBox
// (`tourLang: t.locale`) para esta misma distinción: cada variante de
// idioma de un tour es un documento Strapi propio guiado en ese
// idioma — no es una inferencia de la URL, es el dato real del
// registro de Strapi que ya se está leyendo.
idioma: attrs.locale || null,
booking_mode: bookingMode,
review_mode: reviewMode,

duracion: attrs.duracion ?? null,
maxPersonas: attrs.maxPersonas || 25,

// pricing
pagoLibre: attrs.pago_libre === true,
precioBase: Number(attrs.precio_base ?? attrs.precio ?? 0),
moneda: attrs.moneda || "€",

// meeting point + geo
puntoEncuentro: attrs.punto_encuentro || "",
lat: attrs.coordenadas_lat ?? null,
lng: attrs.coordenadas_lng ?? null,

// ratings

// hero
heroMedia: {
imagen: mediaUrl(heroMedia?.imagen, "large"),
imagenSrcSet: mediaSrcSet(heroMedia?.imagen),
imagenWidth: heroMedia?.imagen?.formats?.large?.width || heroMedia?.imagen?.width || null,
imagenHeight: heroMedia?.imagen?.formats?.large?.height || heroMedia?.imagen?.height || null,
video: heroMedia?.video || "",
},

heroConfig,

badges: String(heroConfig?.badges || "")
.split(",")
.map((b) => b.trim())
.filter(Boolean),

elementosUnicos,

itinerario: (attrs.itinerarios || []).map((p: any) => ({
titulo: p.titulo || "",
duracion: p.duracion || "",
descripcion: p.descripcion || "",
icono: p.icono || "",
imagen: mediaUrl(p.imagen, "medium"),
imagenSrcSet: mediaSrcSet(p.imagen),
imagenWidth: p.imagen?.formats?.medium?.width || p.imagen?.width || null,
imagenHeight: p.imagen?.formats?.medium?.height || p.imagen?.height || null,
})),

// 👇 preparado para guías (NO se usa aún)
guias: Array.isArray(attrs.guias)
  ? attrs.guias
  : attrs.guias?.data || [],


// SEO fields
seoTitle: attrs.seo_title || "",
seoDescription: attrs.seo_description || "",
seoCanonical: attrs.seo_canonical || "",
mostrarRatingHero: attrs.mostrar_rating_hero === true,
};

