<script>
if (typeof window !== "undefined") {
  document.addEventListener("DOMContentLoaded", () => {

    const hero = document.getElementById("tour-hero");
    const description = document.getElementById("tour-description");
    const footer = document.getElementById("main-footer");
    const widget = document.getElementById("bookingWidget");
    const aiButton = document.getElementById("aiFloatingButton");

    if (!hero || !description || !footer || !widget) return;

    const showSticky = () => {
      widget.classList.remove("opacity-0", "translate-y-6", "pointer-events-none");
      aiButton?.classList.remove("opacity-0", "pointer-events-none");
    };

    const hideSticky = () => {
      widget.classList.add("opacity-0", "translate-y-6", "pointer-events-none");
      aiButton?.classList.add("opacity-0", "pointer-events-none");
    };

    // 1️⃣ Oculto mientras hero está visible
    const heroObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          hideSticky();
        }
      },
      { threshold: 0.6 }
    );
    heroObserver.observe(hero);

    // 2️⃣ Mostrar cuando entra descripción
    const descriptionObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          showSticky();
        }
      },
      { threshold: 0.2 }
    );
    descriptionObserver.observe(description);

    // 3️⃣ Ocultar al llegar al footer / mostrar al salir
    const footerObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          hideSticky();
        } else {
          // Al salir del footer hacia arriba, mostrar el sticky
          showSticky();
        }
      },
      { threshold: 0.1 }
    );
    footerObserver.observe(footer);

  });
}
</script>


</Layout>
