        <button
          type="button"
          id="description-toggle-btn"
          aria-expanded="false"
          aria-controls="description-content"
          class="hidden mt-4 text-sm font-bold text-yellow-600 hover:text-yellow-700 underline underline-offset-2"
          data-label-more={dt.readMore}
