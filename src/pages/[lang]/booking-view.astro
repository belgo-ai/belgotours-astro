---
export const prerender = false; // FIX DEFINITIVO

import Layout from "../../layouts/Layout.astro";
import { DateTime } from "luxon";
import { getTourBySlug } from "../../lib/api.js";

const { lang } = Astro.params;

// Leer ID desde ?id=24
const reservaId = Astro.url.searchParams.get("id");

const STRAPI_URL =
  import.meta.env.PUBLIC_STRAPI_URL || "http://localhost:1337/api";

let reserva = null;
let error = null;

let fechaFormateada = "";
let horaFormateada = "";

// =============================
// Traducciones UI
// =============================
const T = {
  pageTitle: {
    es: "Detalle de tu reserva",
    en: "Your booking details",
    it: "Dettagli della tua prenotazione",
    fr: "Détails de votre réservation",
  },
  instructions: {
    es: "Guarda esta página o compártela con tu grupo. Aquí tienes toda la información importante.",
    en: "Save this page or share it with your group. Here is all the important information.",
    it: "Salva questa pagina o condividila con il tuo gruppo. Qui trovi tutte le informazioni importanti.",
    fr: "Enregistrez cette page ou partagez-la avec votre groupe. Voici toutes les informations importantes.",
  },
  meetingPoint: {
    es: "📍 Punto de encuentro",
    en: "📍 Meeting point",
    it: "📍 Punto d'incontro",
    fr: "📍 Point de rendez-vous",
  },
  openMaps: {
    es: "Abrir en Google Maps",
    en: "Open in Google Maps",
    it: "Apri in Google Maps",
    fr: "Ouvrir dans Google Maps",
  },
  tourSummary: {
    es: "Resumen del tour",
    en: "Tour summary",
    it: "Riepilogo del tour",
    fr: "Résumé du tour",
  },
  whatsapp: {
    es: "Compartir por WhatsApp",
    en: "Share via WhatsApp",
    it: "Condividi via WhatsApp",
    fr: "Partager via WhatsApp",
  },
  back: {
    es: "Volver a BelgoTours",
    en: "Back to BelgoTours",
    it: "Torna a BelgoTours",
    fr: "Retour à BelgoTours",
  },
  error: {
    es: "No se pudo cargar la reserva.",
    en: "Could not load booking.",
    it: "Impossibile caricare la prenotazione.",
    fr: "Impossible de charger la réservation.",
  },
  labels: {
    tour: { es: "Tour", en: "Tour", it: "Tour", fr: "Visite" },
    date: { es: "Fecha", en: "Date", it: "Data", fr: "Date" },
    time: { es: "Horario", en: "Time", it: "Orario", fr: "Horaire" },
    participants: {
      es: "Participantes",
      en: "Participants",
      it: "Partecipanti",
      fr: "Participants",
    },
    language: { es: "Idioma", en: "Language", it: "Lingua", fr: "Langue" },
  },
  mapHint: {
    es: "Llega 10–15 minutos antes para encontrar al guía con el paraguas de BelgoTours.",
    en: "Arrive 10–15 minutes early to find the guide with the BelgoTours umbrella.",
    it: "Arriva 10–15 minuti prima per trovare la guida con l’ombrello di BelgoTours.",
    fr: "Arrivez 10 à 15 minutes en avance pour trouver le guide avec le parapluie BelgoTours.",
  },
  // FIX-01B C6 — sin punto de encuentro disponible: nunca uno por defecto
  meetingPointFallback: {
    es: "Consulta el punto de encuentro en tu email de confirmación.",
    en: "Check the meeting point in your confirmation email.",
    it: "Trovi il punto d'incontro nella tua email di conferma.",
    fr: "Retrouvez le point de rendez-vous dans votre email de confirmation.",
  },
  meetingPointContact: {
    es: "¿Dudas? Escríbenos por WhatsApp",
    en: "Questions? Message us on WhatsApp",
    it: "Domande? Scrivici su WhatsApp",
    fr: "Une question ? Écrivez-nous sur WhatsApp",
  },
};

// =============================
// Cargar reserva desde Strapi
// =============================
if (!reservaId) {
  error = T.error[lang];
} else {
  try {
    const url = `${STRAPI_URL}/reservas/public/${encodeURIComponent(
      reservaId
    )}?populate[tour]=*`;
    const res = await fetch(url);

    if (!res.ok) {
  error = T.error[lang];
} else {
  const json = await res.json();
  reserva = json?.data || null;

  if (!reserva) {
    error = T.error[lang];
  } else if (reserva.fecha_hora_tour) {
    const dt = DateTime.fromISO(reserva.fecha_hora_tour, {
      zone: "Europe/Brussels"
    });

    fechaFormateada = dt.setLocale(lang).toLocaleString(DateTime.DATE_FULL);
    horaFormateada = dt.toFormat("HH:mm");
  }
}
  } catch (e) {
    console.error(e);
    error = T.error[lang];
  }
}

// =============================
// Punto de encuentro real del tour reservado (FIX-01 F5)
// =============================
// Antes: "Grand Place 8, 1000 Bruxelles" fijo para todos los tours,
// también los de Brujas. Ahora se lee del tour reservado vía el mismo
// endpoint público que usa su landing (/public/tour/:slug), con el slug
// que ya devuelve /reservas/public/:id. Sin datos nuevos ni PII.
const CITY_FOR_MAPS: Record<string, string> = {
  bruselas: "Bruxelles",
  brujas: "Brugge",
};

let puntoEncuentro = "";
let mapsLink = "";
let mapsEmbed = "";

const textLang = (lang ?? "es") as "es" | "en" | "it" | "fr";
const meetingPointLabel = T.meetingPoint[textLang] ?? T.meetingPoint.es;
const meetingPointFallbackText = T.meetingPointFallback[textLang] ?? T.meetingPointFallback.es;
const meetingPointContactText = T.meetingPointContact[textLang] ?? T.meetingPointContact.es;

if (reserva?.tour?.slug) {
  const tourLocale = ["es", "en", "it", "fr"].includes(reserva.idioma_tour)
    ? reserva.idioma_tour
    : lang;
  try {
    // FIX-01B C6: sin respuesta en 4 s → fallback neutro (no bloquea la página)
    const tourData: any = await Promise.race([
      getTourBySlug(reserva.tour.slug, tourLocale),
      new Promise((_, reject) =>
        setTimeout(() => reject(new Error("timeout punto de encuentro")), 4000)
      ),
    ]);
    const tourAttrs = tourData?.attributes ?? tourData;
    puntoEncuentro = tourAttrs?.punto_encuentro || "";
    const lat = tourAttrs?.coordenadas_lat;
    const lng = tourAttrs?.coordenadas_lng;
    if (lat && lng) {
      // Coordenadas → chincheta en el punto, sin ficha de negocio destacada
      mapsLink = `https://www.google.com/maps?q=${lat},${lng}`;
      mapsEmbed = `https://www.google.com/maps?q=${lat},${lng}&z=17&output=embed`;
    } else if (puntoEncuentro) {
      const city = CITY_FOR_MAPS[reserva.tour.ciudad] || "";
      const query = encodeURIComponent(city ? `${puntoEncuentro}, ${city}` : puntoEncuentro);
      mapsLink = `https://www.google.com/maps/search/?api=1&query=${query}`;
      mapsEmbed = `https://www.google.com/maps?q=${query}&output=embed`;
    }
  } catch (e) {
    console.error("[booking-view] punto de encuentro no disponible", e);
  }
}
---

<Layout lang={lang} noindex={true}>
  <main class="min-h-screen bg-gray-50 py-10 px-4">
    <div class="max-w-5xl mx-auto">

      {error ? (
        <div class="bg-white p-10 rounded-3xl shadow-xl text-center">
          <h1 class="text-3xl font-bold text-red-600 mb-6">{error}</h1>
          <a
            href={`/${lang}/`}
            class="inline-block px-6 py-3 rounded-xl bg-gray-900 text-white font-semibold hover:bg-gray-800"
          >
            {T.back[lang]}
          </a>
        </div>
      ) : (
        <>
          <!-- ENCABEZADO -->
          <div class="mb-6">
            <h1 class="text-4xl font-bold text-gray-900">
              {T.pageTitle[lang]}
            </h1>
            <p class="text-gray-600">{T.instructions[lang]}</p>
          </div>

          <!-- MAPA (sólo con el punto de encuentro real del tour) -->
          {puntoEncuentro && (
          <div class="bg-white rounded-3xl shadow-lg border border-gray-200 overflow-hidden mb-8">
            {mapsEmbed && (
            <iframe
              src={mapsEmbed}
              title={meetingPointLabel}
              class="w-full h-[360px]"
              loading="lazy"
            ></iframe>
            )}

            <div class="p-5 border-t border-gray-200 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div>
                <p class="text-gray-900 font-semibold text-lg">
                  {puntoEncuentro}
                </p>
                <p class="text-gray-600 text-sm">
                  {T.mapHint[lang]}
                </p>
              </div>

              {mapsLink && (
              <a
                href={mapsLink}
                target="_blank"
                class="px-5 py-3 rounded-xl bg-gray-900 text-white font-semibold hover:bg-gray-800 text-sm"
              >
                {T.openMaps[lang]}
              </a>
              )}
            </div>
          </div>
          )}

          {!puntoEncuentro && (
          <div class="bg-white rounded-3xl shadow-lg border border-gray-200 mb-8 p-5">
            <p class="text-gray-900 font-semibold text-lg">
              {meetingPointLabel}
            </p>
            <p class="text-gray-600 text-sm mt-1">
              {meetingPointFallbackText}
            </p>
            <a
              href="https://wa.me/32489829468"
              target="_blank"
              rel="noopener"
              class="inline-block mt-3 text-sm font-semibold text-green-700 underline underline-offset-2"
            >
              {meetingPointContactText}
            </a>
          </div>
          )}

          <!-- RESUMEN -->
          <div class="bg-white rounded-3xl shadow-lg p-8 border border-gray-200 mb-10">
            <h2 class="text-2xl font-bold mb-4">{T.tourSummary[lang]}</h2>

            <div class="grid grid-cols-2 gap-y-2 text-gray-700 text-sm">
              <p class="font-medium">{T.labels.tour[lang]}</p>
              <p>{reserva.tour?.titulo}</p>

              <p class="font-medium">{T.labels.date[lang]}</p>
              <p>{fechaFormateada}</p>

              <p class="font-medium">{T.labels.time[lang]}</p>
              <p>{horaFormateada}</p>

              <p class="font-medium">{T.labels.participants[lang]}</p>
              <p>
                {reserva.adultos} adultos, {reserva.ninos} niños
              </p>

              <p class="font-medium">{T.labels.language[lang]}</p>
              <p>{reserva.idioma_tour?.toUpperCase()}</p>
            </div>
          </div>

          <!-- ACCIONES -->
          <div class="space-y-4">
            <a
              href={`https://wa.me/32489829468?text=${encodeURIComponent(
                `Hola BelgoTours 👋

                  Reserva #${reserva.id}
                  Tour: ${reserva.tour?.titulo}
                  Fecha: ${fechaFormateada}
                  Hora: ${horaFormateada}
                  Participantes: ${reserva.adultos} adultos, ${reserva.ninos} niños`
                  )}`}
              target="_blank"
              class="w-full block text-center px-6 py-4 rounded-xl bg-green-600 text-white font-semibold hover:bg-green-700"
            >
              {T.whatsapp[lang]}
            </a>

            <a
              href={`/${lang}/`}
              class="block text-center px-6 py-4 rounded-xl bg-gray-200 text-gray-800 font-semibold hover:bg-gray-300"
            >
              {T.back[lang]}
            </a>
          </div>
        </>
      )}
    </div>
  </main>
</Layout>
