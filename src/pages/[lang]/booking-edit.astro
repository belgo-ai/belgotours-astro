---
export const prerender = false;

// SEC-P0B / WEB-01 — contención. La edición autoservicio dependía sólo
// del ID secuencial (?id=) y nunca pudo guardar (PUT/DELETE → 405). Los
// emails antiguos aún enlazan aquí, así que la página sólo orienta al
// cliente: modificar = WhatsApp oficial, cancelar = enlace con token del
// email de confirmación. No lee ?id=, no consulta Strapi y no muestra
// datos de la reserva. No reintroducir un formulario sin un token de
// acceso dedicado (ver HANDOFF.md, PUBLIC_RESERVATION_ENDPOINT_CONTRACT).

import Layout from "../../layouts/Layout.astro";
import Icon from "@/components/icons/Icon.astro";

const { lang } = Astro.params;
const uiLang = ["es", "en", "it", "fr"].includes(lang) ? lang : "es";

// Sin ID, nombre, email, teléfono ni token en la URL.
const WHATSAPP_URL = "https://wa.me/32456139612";

const tTitle: Record<string, string> = {
  es: "Cambios en tu reserva",
  en: "Changes to your booking",
  it: "Modifiche alla prenotazione",
  fr: "Modifications de votre réservation",
};

const tNotice: Record<string, string> = {
  es: "Para modificar los datos de tu reserva, contáctanos por WhatsApp. Para cancelar tu reserva, utiliza el enlace de cancelación incluido en tu email de confirmación.",
  en: "To modify your booking details, contact us via WhatsApp. To cancel your booking, use the cancellation link in your confirmation email.",
  it: "Per modificare i dati della prenotazione, contattaci su WhatsApp. Per cancellare la prenotazione, utilizza il link di cancellazione presente nell'email di conferma.",
  fr: "Pour modifier les informations de votre réservation, contactez-nous via WhatsApp. Pour annuler votre réservation, utilisez le lien d’annulation figurant dans votre e-mail de confirmation.",
};

const tWhatsapp: Record<string, string> = {
  es: "Contactar por WhatsApp",
  en: "Contact us via WhatsApp",
  it: "Contattaci su WhatsApp",
  fr: "Nous contacter via WhatsApp",
};

const tBack: Record<string, string> = {
  es: "Volver a BelgoTours",
  en: "Back to BelgoTours",
  it: "Torna a BelgoTours",
  fr: "Retour à BelgoTours",
};
---

<Layout lang={uiLang} noindex={true}>
  <main class="min-h-screen bg-gray-50/80 py-10 px-4">
    <div class="max-w-xl mx-auto">
      <section class="bg-white rounded-3xl shadow-xl border border-gray-100 p-6 md:p-8 text-center">
        <span class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 mb-4">
          <Icon name="message-circle" size={24} />
        </span>

        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
          {tTitle[uiLang]}
        </h1>

        <p id="bookingEditNotice" class="text-sm md:text-base text-gray-700 mb-6">
          {tNotice[uiLang]}
        </p>

        <div class="flex flex-col gap-3">
          <a
            id="bookingEditWhatsapp"
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-green-600 hover:bg-green-700 text-white font-semibold transition"
          >
            <Icon name="message-circle" size={18} />
            <span>{tWhatsapp[uiLang]}</span>
          </a>

          <a
            href={`/${uiLang}/`}
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold transition"
          >
            {tBack[uiLang]}
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>
