---
export const prerender = false;  // ⬅️ 🔥 ESTA LÍNEA ES LA CLAVE
import Layout from "../../layouts/Layout.astro";
import Icon from "@/components/icons/Icon.astro";
import { DateTime } from "luxon";

const { lang } = Astro.params;

// ID desde ?id=123
const reservaId = Astro.url.searchParams.get("id");

const STRAPI_URL =
  import.meta.env.PUBLIC_STRAPI_URL || "http://localhost:1337/api";

let reserva = null;
let error = null;

let fechaFormateada = "";
let horaFormateada = "";
let fechaISO = "";

// =============================
// TRADUCCIONES
// =============================
const T = {
  title: {
    es: "Reserva confirmada",
    en: "Booking confirmed",
    it: "Prenotazione confermata",
    fr: "Réservation confirmée",
  },
  subtitle: {
    es: "Te hemos enviado un email con todos los detalles.",
    en: "We've sent you an email with all the details.",
    it: "Ti abbiamo inviato un'email con tutti i dettagli.",
    fr: "Nous vous avons envoyé un email avec tous les détails.",
  },
  reservationCode: {
    es: "Código de reserva",
    en: "Reservation Code",
    it: "Codice di prenotazione",
    fr: "Code de réservation",
  },
  viewDetails: {
    es: "Ver detalle completo",
    en: "View full details",
    it: "Vedi dettagli completi",
    fr: "Voir les détails complets",
  },
  whatsapp: {
    es: "Compartir por WhatsApp",
    en: "Share via WhatsApp",
    it: "Condividi via WhatsApp",
    fr: "Partager via WhatsApp",
  },
  backToHome: {
    es: "Volver a BelgoTours",
    en: "Back to BelgoTours",
    it: "Torna a BelgoTours",
    fr: "Retour à BelgoTours",
  },
  error: {
    es: "No se pudo cargar tu reserva.",
    en: "We could not load your booking.",
    it: "Impossibile caricare la prenotazione.",
    fr: "Impossible de charger votre réservation.",
  },
};

// WEB-01 — el bloque de detalles estaba en español también en /en/.
// Sólo se localiza EN; ES/IT/FR conservan el copy actual.
const isEn = lang === "en";
const plural = (n: unknown, one: string, many: string) => `${n} ${Number(n) === 1 ? one : many}`;

// =============================
// Cargar reserva desde Strapi
// =============================
if (!reservaId) {
  error = T.error[lang];
} else {
  try {
    const url = `${STRAPI_URL}/reservas/public/${encodeURIComponent(reservaId)}?populate[tour]=*`;
    const res = await fetch(url);

    if (!res.ok) {
  error = T.error[lang];
} else {
  const json = await res.json();
  reserva = json?.data || null;

  if (!reserva) {
    error = T.error[lang];
  } else if (reserva.fecha_hora_tour) {
    const dt = DateTime.fromISO(reserva.fecha_hora_tour, {
      zone: "Europe/Brussels"
    });

    fechaFormateada = dt.setLocale(lang).toLocaleString(DateTime.DATE_FULL);
    horaFormateada = dt.toFormat("HH:mm");
    fechaISO = dt.toFormat("yyyy-LL-dd");
  }
}
  } catch (e) {
    console.error(e);
    error = T.error[lang];
  }
}

// BOOKING-UX-02 — "Compartir por WhatsApp" es para acompañantes (amigos,
// familia): wa.me sin número de destino y sólo datos públicos del tour
// (nombre, fecha, hora, enlace público). Nunca el código de reserva, ni
// datos del cliente, ni URLs privadas o tokens.
const SHARE_INTRO: Record<string, string> = {
  es: "¡Reservado! Nos vamos de tour con BelgoTours:",
  en: "Booked! We're going on a tour with BelgoTours:",
  it: "Prenotato! Andiamo in tour con BelgoTours:",
  fr: "Réservé ! On part en visite avec BelgoTours :",
};
const SHARE_SUBTEXT: Record<string, string> = {
  es: "Envía los datos del tour a quien viene contigo",
  en: "Send the tour details to whoever is coming with you",
  it: "Invia i dettagli del tour a chi viene con te",
  fr: "Envoyez les détails de la visite à ceux qui vous accompagnent",
};
const PARTICIPANTS_SHORT = (adultos: number, ninos: number) => {
  const total = (adultos || 0) + (ninos || 0);
  const word: Record<string, [string, string]> = {
    es: ["persona", "personas"],
    en: ["person", "people"],
    it: ["persona", "persone"],
    fr: ["personne", "personnes"],
  };
  const [one, many] = word[lang ?? "es"] || word.es;
  return `${total} ${total === 1 ? one : many}`;
};
const publicTourUrl =
  reserva?.tour?.slug
    ? new URL(`/${lang}/tours/${reserva.tour.slug}`, Astro.site).toString()
    : new URL(`/${lang}/`, Astro.site).toString();
const shareText = reserva
  ? [
      SHARE_INTRO[lang ?? "es"] || SHARE_INTRO.es,
      reserva.tour?.titulo,
      `${fechaFormateada} · ${horaFormateada}`,
      publicTourUrl,
    ]
      .filter(Boolean)
      .join("\n")
  : "";
const shareHref = `https://wa.me/?text=${encodeURIComponent(shareText)}`;

// A11Y-01 — <title> de la pestaña (antes vacío)
const titleByLang: Record<string, string> = T.title;
const pageTitle = `${error ?? titleByLang[lang ?? "es"] ?? T.title.es} | BelgoTours`;
---

<Layout title={pageTitle} lang={lang} noindex={true}>
  <main class="min-h-screen bg-gray-50 py-6 sm:py-10 px-4">
    <div class="max-w-3xl mx-auto">

      <div class="bg-white shadow-xl rounded-3xl p-5 sm:p-8 border border-gray-100">

        <!-- SI HAY ERROR -->
        {error ? (
          <div class="text-center py-16">
            <h1 class="text-3xl font-bold text-red-600 mb-6">{error}</h1>
            <a
              href={`/${lang}/`}
              class="inline-block px-6 py-3 rounded-xl bg-blue-600 text-white font-semibold hover:bg-blue-700"
            >
              {T.backToHome[lang]}
            </a>
          </div>
        ) : (
          <>
            <!-- ENCABEZADO — BOOKING-UX-02: confirmación, resumen compacto y
                 acciones a la vista en móvil; el detalle extenso va después -->
            <div>
              <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 inline-flex items-center gap-2.5">
                <span class="inline-flex w-9 h-9 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
                  <Icon name="check-circle" size={20} />
                </span>
                {T.title[lang]}
              </h1>
              <p class="text-gray-600 mt-1">{T.subtitle[lang]}</p>
            </div>

            <div class="mt-5 bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3">
              <p class="font-semibold text-gray-900 leading-snug">{reserva.tour?.titulo}</p>
              <p class="text-sm text-gray-700 mt-1">
                {fechaFormateada} · {horaFormateada} · {PARTICIPANTS_SHORT(reserva.adultos, reserva.ninos)}
              </p>
              <p class="text-xs text-gray-600 mt-2">
                {T.reservationCode[lang]}: <span class="font-semibold text-gray-900">{reserva.id}</span>
              </p>
            </div>

            <!-- BOTONES DE ACCIÓN -->
            <div class="mt-5 space-y-3">
              <a
                href={shareHref}
                target="_blank"
                rel="noopener"
                class="w-full flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-green-700 text-white font-semibold hover:bg-green-800"
              >
                <Icon name="message-circle" size={20} />
                {T.whatsapp[lang]}
              </a>
              <p class="text-xs text-gray-600 text-center -mt-1">{SHARE_SUBTEXT[lang ?? "es"] || SHARE_SUBTEXT.es}</p>

              <a
                href={`/${lang}/booking-view?id=${reserva.id}`}
                class="w-full block text-center px-6 py-3.5 rounded-xl border border-gray-300 text-gray-900 font-semibold hover:bg-gray-100"
              >
                {T.viewDetails[lang]}
              </a>

              <a
                href={`/${lang}/`}
                class="block text-center py-2 text-sm font-semibold text-gray-700 underline underline-offset-4 hover:text-gray-900"
              >
                {T.backToHome[lang]}
              </a>
            </div>

            <!-- DETALLE (información extensa, ya resumida arriba) -->
            <div class="mt-8 border-t border-gray-200 pt-6">
              <h2 class="text-base font-semibold mb-3 text-gray-800">
                {isEn ? "Booking details" : "Detalles de tu reserva"}
              </h2>

              <div class="grid grid-cols-2 gap-y-2 text-gray-700 text-sm">
                <p class="font-medium">Tour</p>
                <p>{reserva.tour?.titulo}</p>

                <p class="font-medium">{isEn ? "Date" : "Fecha"}</p>
                <p>{fechaFormateada}</p>

                <p class="font-medium">{isEn ? "Time" : "Horario"}</p>
                <p>{horaFormateada}</p>

                <p class="font-medium">{isEn ? "Participants" : "Participantes"}</p>
                <p>
                  {isEn
                    ? `${plural(reserva.adultos, "adult", "adults")}, ${plural(reserva.ninos, "child", "children")}`
                    : `${plural(reserva.adultos, "adulto", "adultos")}, ${plural(reserva.ninos, "niño", "niños")}`}
                </p>

                <p class="font-medium">{isEn ? "Language" : "Idioma"}</p>
                <p>{reserva.idioma_tour?.toUpperCase()}</p>
              </div>
            </div>

<script
  is:inline
  define:vars={{
    BC_RESERVA_ID: reserva.id,
    BC_TOUR_SLUG: reserva.tour?.slug || "",
    BC_TOUR_NAME: reserva.tour?.titulo || "",
    BC_TOUR_CITY: reserva.tour?.ciudad || "",
    BC_TOUR_TYPE: reserva.tour?.tipo_tour || "",
    BC_CONTENT_LANG: lang,
    BC_TOUR_LANG: reserva.idioma_tour || "",
    BC_SELECTED_DATE: fechaISO,
    BC_SELECTED_TIME: horaFormateada,
    BC_PARTICIPANTS_TOTAL: (reserva.adultos || 0) + (reserva.ninos || 0),
  }}
>
  // Fuente de verdad: sólo llega aquí si el SSR confirmó una reserva
  // real vía GET a Strapi (ver frontmatter). BC_RESERVA_ID se usa
  // ÚNICAMENTE como parte de la clave local de dedupe — nunca se
  // envía a GA4.
  (function () {
    if (!window.BTAnalytics) return;
    if (!window.BTAnalytics.onceGuard("bc_" + BC_RESERVA_ID)) return;
    window.BTAnalytics.trackEvent("booking_confirmed", {
      tour_slug: BC_TOUR_SLUG,
      tour_name: BC_TOUR_NAME,
      tour_city: BC_TOUR_CITY,
      tour_type: BC_TOUR_TYPE,
      content_language: BC_CONTENT_LANG,
      tour_language: BC_TOUR_LANG,
      selected_date: BC_SELECTED_DATE,
      selected_time: BC_SELECTED_TIME,
      participants_total: BC_PARTICIPANTS_TOTAL,
    });
  })();
</script>

          </>
        )}
      </div>
    </div>
  </main>
</Layout>
